---
interface Props {
  keys: string[];
}

const { keys } = Astro.props;
const keycaps: Record<string, { label: string; symbol: string; className: string }> = {
  command: { label: "Command", symbol: "⌘", className: "is-modifier" },
  control: { label: "Control", symbol: "⌃", className: "is-modifier" },
  option: { label: "Option", symbol: "⌥", className: "is-modifier" },
  shift: { label: "Shift", symbol: "⇧", className: "is-modifier" },
  escape: { label: "Escape", symbol: "Esc", className: "is-wide" },
  click: { label: "Click", symbol: "click", className: "is-word" }
};
const metadata = keys.map((key) => keycaps[key] ?? {
  label: key.length === 1 ? key.toUpperCase() : key,
  symbol: key.length === 1 ? key.toUpperCase() : key,
  className: key.length === 1 ? "is-letter" : "is-word"
});
---

<span class="shortcut-keys" aria-label={metadata.map((key) => key.label).join("-")}>
  {metadata.map((key) => <kbd class={key.className} title={key.label}>{key.symbol}</kbd>)}
</span>

<style>
  .shortcut-keys {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    align-items: center;
    vertical-align: middle;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 0.44rem;
    border-radius: 7px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.05)),
      #17171f;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -1px 0 rgb(0 0 0 / 0.42),
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 1px 2px rgb(0 0 0 / 0.32);
    color: var(--docs-ink);
    font-family:
      -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1;
  }

  kbd.is-modifier {
    font-size: 1.02rem;
  }

  kbd.is-letter {
    min-width: 1.72rem;
    font-size: 0.78rem;
    letter-spacing: 0;
  }

  kbd.is-wide,
  kbd.is-word {
    min-width: auto;
    padding-inline: 0.58rem;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  kbd.is-word {
    text-transform: none;
  }
</style>

---
import { defaultLocale, type Locale } from "../i18n/config";
import { menuBarDemoCopy } from "../i18n/menu-bar-demo";

/**
 * Interactive macOS menu bar demo with Luxel as a status item.
 * Recreates option 11a from the Claude Design handoff: click the status
 * icon to toggle the capture panel, switch modes, pick targets from native
 * menus, and hit record to swap the status item for the live recording pill.
 * UI state only — nothing records.
 */

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const t = menuBarDemoCopy(locale);

const menuTitles = [t.menuFile, t.menuEdit, t.menuView, t.menuGo, t.menuWindow, t.menuHelp];
const trimmedMenuCount = 3;

const modes = [
  { mode: "display", label: t.modeDisplay },
  { mode: "window", label: t.modeWindow },
  { mode: "area", label: t.modeArea },
  { mode: "audio", label: t.modeAudio }
];

const recordAppLabel = (name: string) => t.recordApp.replace("{name}", name);

const devices = [
  { key: "sys", label: t.ariaSystemAudio, on: true },
  { key: "mic", label: t.ariaMicrophone, on: false },
  { key: "cam", label: t.ariaCamera, on: false }
];

const handwritingFonts: Partial<Record<Locale, string>> = {
  ja: "Yomogi",
  ko: "Gaegu",
  "zh-Hans": "Long Cang"
};
const handFont = handwritingFonts[locale] ?? "Patrick Hand";
const handFontHref = `https://fonts.googleapis.com/css2?family=${handFont.replaceAll(" ", "+")}&display=swap&text=${encodeURIComponent(t.tryMe)}`;

const targetGroups = [
  {
    mode: "display",
    options: [
      { label: t.display1, chip: t.display1, rec: t.recordDisplay1 },
      { label: t.display2, chip: t.display2, rec: t.recordDisplay2 }
    ]
  },
  {
    mode: "window",
    options: [
      { label: t.frontWindow, chip: t.frontWindow, rec: t.recordFrontWindow },
      ...["Safari", "Google Chrome", t.notesApp, "Keynote", "Figma"].map((name) => ({
        label: name,
        chip: name,
        rec: recordAppLabel(name)
      }))
    ]
  },
  {
    mode: "area",
    options: [
      { label: t.areaSize, chip: t.areaChip, rec: t.recordSelection },
      { label: t.selectNewArea, chip: t.selectNewArea, rec: t.recordSelection }
    ]
  },
  {
    mode: "audio",
    options: [
      { label: t.systemAudioMic, chip: t.systemAudioMic, rec: t.recordAudio },
      { label: t.systemAudioOnly, chip: t.systemAudioOnly, rec: t.recordAudio },
      { label: t.microphoneOnly, chip: t.microphoneOnly, rec: t.recordAudio }
    ]
  }
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={handFontHref} />

<section class="mbdemo" data-mode="display" data-sys data-locale={locale} aria-label={t.ariaSection}>
  <div class="mbdemo__bar">
    <div class="mbdemo__menus">
      <span class="mbdemo__menuitem mbdemo__menuitem--glyph" aria-hidden="true">
        <span class="mbdemo__glyph"><span></span></span>
      </span>
      <span class="mbdemo__menuitem mbdemo__menuitem--app" aria-hidden="true">Luxel</span>
      {
        menuTitles.map((title, index) => (
          <span
            class:list={[
              "mbdemo__menuitem",
              { "mbdemo__menuitem--trim": index >= menuTitles.length - trimmedMenuCount }
            ]}
            aria-hidden="true"
          >
            {title}
          </span>
        ))
      }
    </div>
    <div class="mbdemo__status">
      <button type="button" class="mbdemo__statusicon" data-mb-toggle aria-expanded="false" aria-label={t.ariaTogglePanel}>
        <span class="mbdemo__glyph"><span></span></span>
      </button>
      <button type="button" class="mbdemo__live" data-mb-stop aria-label={t.ariaStopRecording}>
        <span class="mbdemo__livedot"></span>
        <span class="mbdemo__wave">
          <span class="mbdemo__wavetrack">
            <span class="mbdemo__wavegroup"><i style="height:9px"></i><i style="height:3px"></i><i style="height:3px"></i><i style="height:11px"></i><i style="height:6px"></i><i style="height:12px"></i><i style="height:3px"></i><i style="height:8px"></i><i style="height:4px"></i><i style="height:10px"></i><i style="height:3px"></i><i style="height:13px"></i><i style="height:7px"></i><i style="height:11px"></i></span>
            <span class="mbdemo__wavegroup"><i style="height:9px"></i><i style="height:3px"></i><i style="height:3px"></i><i style="height:11px"></i><i style="height:6px"></i><i style="height:12px"></i><i style="height:3px"></i><i style="height:8px"></i><i style="height:4px"></i><i style="height:10px"></i><i style="height:3px"></i><i style="height:13px"></i><i style="height:7px"></i><i style="height:11px"></i></span>
          </span>
        </span>
        <span class="mbdemo__livetime" data-mb-time>0:00</span>
        <span class="mbdemo__livestop"></span>
      </button>
      <span class="mbdemo__sysicon" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.88)" stroke-width="1.9" stroke-linecap="round"><path d="M12 18.5h.01"></path><path d="M8.8 15.2a4.5 4.5 0 0 1 6.4 0"></path><path d="M5.9 12.1a8.7 8.7 0 0 1 12.2 0"></path><path d="M3 9a13 13 0 0 1 18 0"></path></svg>
      </span>
      <span class="mbdemo__sysicon mbdemo__sysicon--battery" aria-hidden="true">
        <svg width="22" height="12" viewBox="0 0 28 14"><rect x="1" y="1.5" width="22" height="11" rx="3" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.4"></rect><rect x="3" y="3.5" width="14" height="7" rx="1.5" fill="rgba(255,255,255,.9)"></rect><path d="M25 5v4a2.4 2.4 0 0 0 0-4z" fill="rgba(255,255,255,.5)"></path></svg>
      </span>
      <span class="mbdemo__sysicon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.88)" stroke-width="1.8" stroke-linecap="round"><rect x="2.5" y="4.5" width="19" height="6" rx="3"></rect><circle cx="6.5" cy="7.5" r="1.6" fill="rgba(255,255,255,.88)" stroke="none"></circle><rect x="2.5" y="13.5" width="19" height="6" rx="3"></rect><circle cx="17.5" cy="16.5" r="1.6" fill="rgba(255,255,255,.88)" stroke="none"></circle></svg>
      </span>
      <span class="mbdemo__clock" data-mb-clock aria-hidden="true"></span>
    </div>
  </div>

  <div class="mbdemo__tryme" style={`font-family: "${handFont}", "Bradley Hand", "Marker Felt", Noteworthy, cursive`}>
    <span>{t.tryMe}</span>
    <svg width="56" height="24" viewBox="0 0 56 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 19c14 4 34-2 48-12"></path><path d="M43.5 5.5L50 7l-2 6.5"></path></svg>
  </div>

  <div class="mbdemo__panel">
    <div class="mbdemo__island mbdemo__island--capture">
      <div class="mbdemo__segs">
        {
          modes.map(({ mode, label }) => (
            <button type="button" class="mbdemo__seg" data-mb-mode={mode}>
              {mode === "display" && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="13" rx="3" /><path d="M12 17v4" /><path d="M8 21h8" /></svg>
              )}
              {mode === "window" && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="15" rx="2.5" /><path d="M3 9h18" /></svg>
              )}
              {mode === "area" && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V6.5A2.5 2.5 0 0 1 6.5 4H9" /><path d="M15 4h2.5A2.5 2.5 0 0 1 20 6.5V9" /><path d="M20 15v2.5a2.5 2.5 0 0 1-2.5 2.5H15" /><path d="M9 20H6.5A2.5 2.5 0 0 1 4 17.5V15" /></svg>
              )}
              {mode === "audio" && (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 10v4" /><path d="M7.5 7v10" /><path d="M12 4v16" /><path d="M16.5 7v10" /><path d="M21 10v4" /></svg>
              )}
              <span>{label}</span>
            </button>
          ))
        }
      </div>
      <div class="mbdemo__recwrap">
        <button type="button" class="mbdemo__ring" data-mb-record aria-label={t.ariaToggleRecording}>
          <span class="mbdemo__ringinner"></span>
        </button>
        <span class="mbdemo__cap">
          <span class="mbdemo__cap-idle" data-mb-rec-label>{t.recordDisplay1}</span>
          <span class="mbdemo__cap-live">{t.recording}&ensp;<span data-mb-time>0:00</span>&ensp;·&ensp;{t.clickToStop}</span>
        </span>
        <div class="mbdemo__target">
          <span class="mbdemo__tchip" aria-hidden="true">
            <span data-mb-target-label>{t.display1}</span>
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9.5l4-4.5 4 4.5"></path><path d="M8 14.5l4 4.5 4-4.5"></path></svg>
          </span>
          {
            targetGroups.map(({ mode, options }) => (
              <select class="mbdemo__tselect" data-mb-select={mode} aria-label={t.ariaTarget}>
                {options.map((option, index) => (
                  <option selected={index === 0} data-chip-label={option.chip} data-rec-label={option.rec}>
                    {option.label}
                  </option>
                ))}
              </select>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mbdemo__island mbdemo__island--library">
      <div class="mbdemo__file">
        <div class="mbdemo__thumb">
          <span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M7 5v14M17 5v14M3 9.5h4M3 14.5h4M17 9.5h4M17 14.5h4"></path></svg>
          </span>
        </div>
        <div class="mbdemo__filemeta">
          <div class="mbdemo__filename">Luxel 2026-08-24</div>
          <div class="mbdemo__filesub">00:22 · 10.8 MB · MP4</div>
        </div>
        <div class="mbdemo__folder">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2.2 2.3h7.2A2.5 2.5 0 0 1 21 9.8v6.7a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5V7.5z"></path></svg>
        </div>
      </div>
      <div class="mbdemo__divider"></div>
      <div class="mbdemo__devices">
        {
          devices.map(({ key, label, on }) => (
            <div class="mbdemo__devgroup">
              <button
                type="button"
                class="mbdemo__dev"
                {...{ [`data-mb-${key}`]: true }}
                aria-pressed={String(on)}
                aria-label={label}
              >
                {key === "sys" && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3.5 9.5v5H7l5 4v-14l-5 4H3.5z" fill="currentColor" stroke="none" /><path d="M15.5 9a4.5 4.5 0 0 1 0 6" /><path d="M18.5 6.5a8.5 8.5 0 0 1 0 11" /><path class="mbdemo__slash" d="M4.5 4l15 16" /></svg>
                )}
                {key === "mic" && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="9" y="2.5" width="6" height="11.5" rx="3" /><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0" /><path d="M12 18v3.5" /><path class="mbdemo__slash" d="M4.5 4l15 16" /></svg>
                )}
                {key === "cam" && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="13" height="12" rx="3.5" /><path d="M15.5 10.5l6-3.5v10l-6-3.5" /><path class="mbdemo__slash" d="M4.5 4l15 16" /></svg>
                )}
              </button>
              <span class="mbdemo__devsep"></span>
              <span class="mbdemo__devchev">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 9.5l5.5 5.5 5.5-5.5" /></svg>
              </span>
            </div>
          ))
        }
        <div class="mbdemo__more">
          <span class="mbdemo__morebtn" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.8" fill="currentColor"></circle><circle cx="12" cy="12" r="1.8" fill="currentColor"></circle><circle cx="19" cy="12" r="1.8" fill="currentColor"></circle></svg>
          </span>
          <select class="mbdemo__mselect" data-mb-more aria-label={t.ariaMore}>
            <option data-action="settings">{t.settings}</option>
            <option data-action="quit">{t.quitLuxel}</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector(".mbdemo");
    if (!root) {
      return;
    }

    const timeLabels = root.querySelectorAll("[data-mb-time]");
    const recLabel = root.querySelector("[data-mb-rec-label]");
    const chipLabel = root.querySelector("[data-mb-target-label]");
    const panelToggle = root.querySelector("[data-mb-toggle]");
    const panel = root.querySelector(".mbdemo__panel");
    const clock = root.querySelector("[data-mb-clock]");

    let seconds = 0;
    let timer = 0;

    const setTime = () => {
      const text = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
      timeLabels.forEach((label) => {
        label.textContent = text;
      });
    };

    const setOpen = (on) => {
      root.toggleAttribute("data-open", on);
      panelToggle.setAttribute("aria-expanded", String(on));
    };

    const syncLabels = () => {
      const picked = root.querySelector(`[data-mb-select="${root.dataset.mode}"]`).selectedOptions[0];
      recLabel.textContent = picked.dataset.recLabel;
      chipLabel.textContent = picked.dataset.chipLabel;
    };

    const stopRecording = () => {
      clearInterval(timer);
      seconds = 0;
      setTime();
      root.toggleAttribute("data-recording", false);
      setOpen(true);
    };

    const startRecording = () => {
      clearInterval(timer);
      seconds = 0;
      setTime();
      root.toggleAttribute("data-recording", true);
      setOpen(false);
      timer = setInterval(() => {
        seconds += 1;
        setTime();
      }, 1000);
    };

    const toggleRecording = () => {
      if (root.hasAttribute("data-recording")) {
        stopRecording();
      } else {
        startRecording();
      }
    };

    panelToggle.addEventListener("click", () => {
      setOpen(!root.hasAttribute("data-open"));
    });

    const liveStop = root.querySelector("[data-mb-stop]");

    document.addEventListener("click", (event) => {
      if (!root.hasAttribute("data-open")) {
        return;
      }
      if (
        panel.contains(event.target) ||
        panelToggle.contains(event.target) ||
        liveStop.contains(event.target)
      ) {
        return;
      }
      setOpen(false);
    });

    liveStop.addEventListener("click", toggleRecording);
    root.querySelector("[data-mb-record]").addEventListener("click", toggleRecording);

    root.querySelectorAll("[data-mb-mode]").forEach((segment) => {
      segment.addEventListener("click", () => {
        if (root.hasAttribute("data-recording")) {
          return;
        }
        root.dataset.mode = segment.dataset.mbMode;
        syncLabels();
      });
    });

    root.querySelectorAll("[data-mb-select]").forEach((select) => {
      select.addEventListener("change", syncLabels);
    });

    const moreSelect = root.querySelector("[data-mb-more]");
    moreSelect.selectedIndex = -1;
    moreSelect.addEventListener("change", () => {
      if (moreSelect.selectedOptions[0]?.dataset.action === "quit") {
        setOpen(false);
      }
      moreSelect.selectedIndex = -1;
    });

    [["data-mb-sys", "data-sys"], ["data-mb-mic", "data-mic"], ["data-mb-cam", "data-cam"]].forEach(
      ([selector, flag]) => {
        const device = root.querySelector(`[${selector}]`);
        device.addEventListener("click", () => {
          const on = !root.hasAttribute(flag);
          root.toggleAttribute(flag, on);
          device.setAttribute("aria-pressed", String(on));
        });
      }
    );

    const weekdayFormat = new Intl.DateTimeFormat(root.dataset.locale, { weekday: "short" });
    const clockFormat = new Intl.DateTimeFormat(root.dataset.locale, {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23"
    });
    const tickClock = () => {
      const now = new Date();
      clock.textContent = `${weekdayFormat.format(now)} ${clockFormat.format(now)}`;
    };
    tickClock();
    setInterval(tickClock, 10000);

    if (window.matchMedia("(min-width: 900px)").matches) {
      setOpen(true);
    }
  })();
</script>

<style>
  .mbdemo {
    --mb-tint: #ff453a;
    position: sticky;
    top: 0;
    z-index: 60;
    font-family:
      -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
    color: rgb(255 255 255 / 0.96);
  }

  /* keep the floating site nav below the stuck menu bar */
  :global(.mbdemo ~ .nav) {
    top: 48px;
  }

  :where(.mbdemo button) {
    padding: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    text-align: inherit;
  }

  /* ---- menu bar ---- */
  .mbdemo__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding-inline: 24px;
    background: rgb(18 18 28 / 0.62);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06);
  }

  .mbdemo__menus {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 13px;
  }

  .mbdemo__menuitem {
    padding: 3px 10px;
    border-radius: 6px;
    color: rgb(255 255 255 / 0.85);
    cursor: default;
    white-space: nowrap;
  }

  .mbdemo__menuitem--glyph {
    display: grid;
    place-items: center;
  }

  .mbdemo__menuitem--app {
    color: inherit;
    font-weight: 700;
  }

  .mbdemo__glyph {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 2px solid rgb(255 255 255 / 0.92);
    border-radius: 50%;
  }

  .mbdemo__glyph span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
  }

  .mbdemo__status {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .mbdemo__statusicon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 24px;
    border-radius: 6px;
    transition: background 150ms ease;
  }

  .mbdemo__statusicon:active {
    transform: scale(0.94);
  }

  .mbdemo[data-open] .mbdemo__statusicon {
    background: rgb(255 255 255 / 0.22);
  }

  .mbdemo[data-recording] .mbdemo__statusicon {
    display: none;
  }

  .mbdemo__live {
    display: none;
    align-items: center;
    gap: 9px;
    padding: 5px 11px 5px 10px;
    border-radius: 9px;
    background: rgb(10 10 16 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09);
    transition: background 150ms ease;
  }

  .mbdemo[data-recording] .mbdemo__live {
    display: flex;
  }

  .mbdemo__live:active {
    transform: scale(0.96);
  }

  .mbdemo__livedot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--mb-tint);
    box-shadow: 0 0 9px rgb(255 69 58 / 0.7);
  }

  .mbdemo__wave {
    display: flex;
    align-items: center;
    width: 58px;
    height: 14px;
    overflow: hidden;
  }

  .mbdemo__wavetrack {
    display: flex;
    align-items: center;
    width: max-content;
    animation: mbdemo-wave 2.6s linear infinite;
  }

  .mbdemo__wavegroup {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: 2px;
  }

  .mbdemo__wavegroup i {
    width: 2px;
    border-radius: 1px;
    background: #ff5348;
  }

  .mbdemo__wavegroup i:nth-child(n + 8) {
    background: rgb(255 255 255 / 0.85);
  }

  .mbdemo__livetime {
    color: rgb(255 255 255 / 0.95);
    font: 600 12px ui-monospace, Menlo, monospace;
  }

  .mbdemo__livestop {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.92);
  }

  .mbdemo__sysicon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 24px;
    border-radius: 6px;
    cursor: default;
  }

  .mbdemo__clock {
    min-width: 74px;
    padding: 3px 8px;
    border-radius: 6px;
    color: rgb(255 255 255 / 0.88);
    font-size: 12.5px;
    font-weight: 500;
    text-align: end;
    white-space: nowrap;
    cursor: default;
  }

  /* ---- try-me label ---- */
  .mbdemo__tryme {
    position: absolute;
    top: 0;
    right: 304px;
    display: flex;
    align-items: center;
    height: 34px;
    color: rgb(255 255 255 / 0.9);
    font-size: 17.5px;
    letter-spacing: 0.02em;
    pointer-events: none;
    transform: rotate(-2.5deg);
    white-space: nowrap;
  }

  /* springs from the text, dips below the bar, and aims at the status icon */
  .mbdemo__tryme svg {
    position: absolute;
    top: 18px;
    left: calc(100% + 5px);
    opacity: 0.85;
  }

  .mbdemo[data-open] .mbdemo__tryme,
  .mbdemo[data-recording] .mbdemo__tryme {
    display: none;
  }

  /* ---- panel ---- */
  .mbdemo__panel {
    position: absolute;
    top: 42px;
    right: 128px;
    z-index: 60;

---
import "../styles/global.css";
import { commonCopy } from "../i18n/common";
import { defaultLocale, type Locale, type PublicPagePath } from "../i18n/config";
import { translate } from "../i18n/text";
import LocaleRedirect from "./LocaleRedirect.astro";
import LocalizedSeo from "./LocalizedSeo.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteNav from "./SiteNav.astro";

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  navigationLabel: string;
  path: PublicPagePath;
  locale?: Locale;
  showsLeftGlow?: boolean;
}

const {
  title,
  description,
  bodyClass,
  navigationLabel,
  path,
  locale = defaultLocale,
  showsLeftGlow = false
} = Astro.props;
const copy = commonCopy(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="apple-itunes-app" content="app-id=6800438206" />
    <link rel="icon" href="/luxel-icon.svg" type="image/svg+xml" />
    <LocalizedSeo locale={locale} path={path} />
    {locale === defaultLocale && <LocaleRedirect path={path} />}
    <link rel="alternate" href="/llms.txt" type="text/markdown" title={translate(locale, "Luxel LLM-readable index")} />
    <link rel="alternate" href="/llms-full.txt" type="text/markdown" title={translate(locale, "Luxel full Markdown documentation")} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div class="page">
      <div class="ambient" aria-hidden="true">
        <span class="ambient__glow ambient__glow--hero"></span>
        {showsLeftGlow && <span class="ambient__glow ambient__glow--left"></span>}
      </div>

      <SiteNav
        locale={locale}
        ariaLabel={navigationLabel}
        links={[
          { href: "/#features", label: copy.nav.features },
          { href: "/docs", label: copy.nav.docs },
          { href: "/support", label: copy.nav.support },
          { href: "/privacy", label: copy.nav.privacy }
        ]}
      />

      <slot />
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>

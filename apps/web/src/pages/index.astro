---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const macAppStoreUrl = "https://apps.apple.com/us/app/luxel/id6780682473?mt=12";

const navLinks = [
  { href: "#features", label: "Features" },
  { href: "/docs", label: "Docs" },
  { href: "/support", label: "Support" },
  { href: "/privacy", label: "Privacy" }
];

const featureTrio = [
  {
    title: "Capture",
    text: "Record displays, windows, selected areas, audio, and camera overlays with cursor, click, countdown, and auto-stop controls.",
    icon: "display"
  },
  {
    title: "Replay Buffer",
    text: "Keep recent screen history ready, then export the last 30 seconds, 1 minute, 2 minutes, or 5 minutes.",
    icon: "clock"
  },
  {
    title: "CLI and Automation",
    text: "Start and stop captures, make replay clips, open recordings or settings, and use callbacks and URL workflows from scripts.",
    icon: "terminal"
  }
];

const menuCapturePoints = [
  "Display, window, and selected-area targets",
  "System audio, microphone, and camera overlays with three shapes, Cutout, and Green Screen",
  "1–120 FPS or display-matched capture, plus countdown, auto-stop, pause, and resume"
];

const replayBufferPoints = [
  "30 second, 1 minute, 2 minute, and 5 minute buffers",
  "24 or 30 FPS with optional system audio",
  "Clip to the editor or a configured quick export destination"
];

const editorFacts = [
  "MP4, HEVC MP4, ProRes 422, ProRes 4444, GIF, APNG, WebM, AV1, and audio-only exports",
  "Compact, Balanced, High, lossless, size estimates, level, and normalize controls",
  "Multi-format batches, Finder actions, copy path, copy file, and Share"
];

const transcriptPoints = [
  "Locale selection and semantic turn segmentation",
  "Local speaker diarization with Auto, Exact, or Range count detection",
  "Known Speaker matching, voice naming, transcript search, and editor review"
];

const cliPoints = [
  "Record displays, active windows, or selected areas from scripts",
  "Start, stop, toggle, clip, reveal recent recordings, and open Settings",
  "x-success and x-error callbacks with --wait, --json, and --print-url"
];

const settingsPoints = [
  "Searchable global shortcuts with conflict warnings",
  "Quick Recording presets with size, frame rate, destination, and post-action",
  "Recording, output, transcripts, notch, replay buffer, command-line, and system settings"
];

const languages = [
  "English",
  "Deutsch",
  "Español",
  "Français",
  "Italiano",
  "日本語",
  "한국어",
  "Tiếng Việt",
  "简体中文",
  "Português (BR)",
  "Português (PT)"
];

const agentPoints = [
  "--json results plus x-success and x-error callbacks",
  "luxel:// URL scheme and App Shortcuts for app-level automation",
  "Recording and replay automation run locally"
];

const localPoints = [
  "No watermarks, time limits, or export restrictions.",
  "No tracking, analytics, or cloud recording.",
  "Recording, editing, export, and transcription run locally."
];

const exportFormats = ["MP4", "HEVC", "ProRes", "GIF", "APNG", "WebM", "AV1", "M4A", "WAV", "FLAC"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Luxel is a Mac menu bar recorder for screen capture, replay buffer clips, local transcripts, command-line automation, and polished exports."
    />
    <meta name="apple-itunes-app" content="app-id=6780682473" />
    <link rel="icon" href="/luxel-icon.svg" type="image/svg+xml" />
    <link rel="alternate" href="/llms.txt" type="text/markdown" title="Luxel LLM-readable index" />
    <link rel="alternate" href="/llms-full.txt" type="text/markdown" title="Luxel full Markdown documentation" />
    <title>Luxel - Screen recording for Mac</title>
  </head>
  <body>
    <div class="page" id="top">
      <div class="ambient" aria-hidden="true">
        <span class="ambient__glow ambient__glow--hero"></span>
        <span class="ambient__glow ambient__glow--left"></span>
        <span class="ambient__glow ambient__glow--right"></span>
        <span class="ambient__glow ambient__glow--low"></span>
      </div>

      <SiteNav links={navLinks} ariaLabel="Page sections" />

      <main>
        <section class="hero container" aria-labelledby="hero-title">
          <p class="hero__badge">
            <span class="live-dot" aria-hidden="true"></span>
            Menu bar recorder for macOS
          </p>
          <h1 class="hero__title gradient-title" id="hero-title">Capture made for Mac.</h1>
          <p class="hero__lead">
            Record screens, clip the last few minutes, transcribe locally, automate from the CLI,
            and export without ceremony.
          </p>
          <div class="hero__actions" aria-label="Primary actions">
            <a
              class="app-store-link"
              href={macAppStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Download Luxel on the Mac App Store"
            >
              <img
                src="/app-store/mac-app-store-badge.svg"
                alt="Download on the Mac App Store"
                width="156"
                height="48"
              />
            </a>
            <a class="glass-button" href="/docs">Read docs</a>
            <a class="hero__more" href="#notch">See recording controls →</a>
          </div>

          <div class="hero__stage" aria-label="Luxel app screenshots">
            <div class="hero__card hero__card--settings">
              <img
                src="/screenshots/luxel-settings-replay-buffer.png"
                alt="Luxel Replay Buffer settings window"
                width="1800"
                height="1384"
              />
            </div>
            <div class="hero__card hero__card--menu">
              <img
                src="/screenshots/luxel-menu-capture-under-menu-bar.png"
                alt="Luxel menu bar capture panel below the macOS menu bar"
                width="1114"
                height="896"
              />
            </div>
          </div>
        </section>

        <section class="trio container" id="features" aria-label="Feature overview">
          {featureTrio.map((feature) => (
            <article class="glass-card trio__card">
              <span class="trio__icon" aria-hidden="true">
                {feature.icon === "display" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="13" rx="3"></rect><path d="M12 17v4"></path><path d="M8 21h8"></path></svg>
                )}
                {feature.icon === "clock" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>
                )}
                {feature.icon === "terminal" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l6-5-6-5"></path><path d="M12 19h8"></path></svg>
                )}
              </span>
              <h2 class="trio__title">{feature.title}</h2>
              <p>{feature.text}</p>
            </article>
          ))}
        </section>

        <section class="section container" id="area-recording" aria-labelledby="area-title">
          <div class="section__head">
            <p class="eyebrow">Area recording</p>
            <h2 class="section__title" id="area-title">Draw a box. Record inside it.</h2>
            <p class="section__lead">
              Drag a boundary box anywhere on screen and Luxel records only what's inside. Size
              presets, aspect ratios, microphone, camera, delay, and auto-stop stay attached to the
              selection.
            </p>
          </div>
          <div class="frame frame--fit">
            <img
              src="/screenshots/luxel-area-selection.png"
              alt="Luxel area selection with boundary box, dimension pill, and recording toolbar"
              width="1200"
              height="870"
              loading="lazy"
            />
          </div>
        </section>

        <section class="section section--wide container" id="primary-features" aria-labelledby="primary-features-title">
          <div class="section__head section__head--wide">
            <p class="eyebrow">Primary features</p>
            <h2 class="section__title" id="primary-features-title">
              Everything Luxel can do, in one Mac workflow.
            </h2>
            <p class="section__lead">
              Capture, replay, export, transcripts, automation, and localization stay inside one
              focused Mac app.
            </p>
          </div>

          <article class="feature-row" id="capture">
            <div class="feature-row__copy">
              <p class="chip chip--red">Record</p>
              <h3>Menu bar capture</h3>
              <p>
                Start display, window, area, and audio-only recordings from the menu bar. Luxel
                keeps target selection, audio toggles, cursor visibility, click highlights,
                permission status, recent files, and quick recording controls close without opening
                a full app window.
              </p>
              <ul class="points">
                {menuCapturePoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>
            <div class="feature-row__media">
              <img
                class="feature-row__media--panel"
                src="/screenshots/luxel-menu-capture-panel.png"
                alt="Luxel menu bar capture panel"
                width="640"
                height="786"
                loading="lazy"
              />
            </div>
          </article>

          <article class="feature-row feature-row--flip" id="replay-buffer">
            <div class="feature-row__media">
              <img
                src="/screenshots/luxel-settings-replay-buffer.png"
                alt="Luxel Replay Buffer settings"
                width="1800"
                height="1384"
                loading="lazy"
              />
            </div>
            <div class="feature-row__copy">
              <p class="chip chip--indigo">Recover</p>
              <h3>Replay buffer</h3>
              <p>
                Turn on the replay buffer when you need to capture what just happened. Luxel keeps
                recent screen activity ready and saves a replay clip without stopping the buffer.
              </p>
              <ul class="points">
                {replayBufferPoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </article>

          <div class="showcase" id="editor-export">
            <div class="showcase__head">
              <p class="chip chip--red">Polish</p>
              <h3>Editor and export</h3>
              <p>
                Open recordings in the editor to trim, resize, retime, crop-to-fill, adjust audio,
                copy frames, save originals, and export video, animation, or audio files from the
                same workspace.
              </p>
            </div>
            <div class="frame">
              <img
                src="/screenshots/luxel-editor-loaded.png"
                alt="Luxel editor window with export panels"
                width="1800"
                height="1184"
                loading="lazy"
              />
            </div>
            <ul class="fact-grid" aria-label="Editor and export details">
              {editorFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>

          <article class="feature-row feature-row--flip" id="transcripts">
            <div class="feature-row__media">
              <img
                src="/screenshots/luxel-audio-transcript-editor.png"
                alt="Luxel editor with searchable transcript"
                width="2224"
                height="1648"
                loading="lazy"
              />
            </div>
            <div class="feature-row__copy">
              <p class="chip chip--indigo">Text</p>
              <h3>Local transcripts</h3>
              <p>
                Transcribe recordings on your Mac, search and jump through transcript text in the
                editor, and choose automatic turn grouping for easier review.
              </p>
              <ul class="points">
                {transcriptPoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </article>

          <div class="feature-columns" id="cli">
            <article class="glass-card feature-column">
              <p class="chip chip--red chip--small">Automate</p>
              <h3>Command line and URL control</h3>
              <p>
                Install the bundled luxel command from Settings and control Luxel from shell
                scripts, launchers, URL automation, or Shortcuts.
              </p>
              <div class="code-block" aria-label="Example luxel commands">
                <div><span class="code-prompt">$</span> luxel record --display 1</div>
                <div><span class="code-prompt">$</span> luxel clip --seconds 30 --json</div>
                <div><span class="code-prompt">$</span> luxel latest --reveal</div>
              </div>
              <ul class="points points--small">
                {cliPoints.map((point) => <li>{point}</li>)}
              </ul>
            </article>
            <article class="glass-card feature-column" id="settings-shortcuts">
              <p class="chip chip--indigo chip--small">Control</p>
              <h3>Settings, shortcuts, and presets</h3>
              <p>
                Tune Luxel for repeated work with editable global shortcuts, quick export presets,
                reusable crop sizes, command-line installation, update controls, and replay buffer
                behavior.
              </p>
              <ul class="points points--small">
                {settingsPoints.map((point) => <li>{point}</li>)}
              </ul>
            </article>
            <article class="glass-card feature-column" id="localization">
              <p class="chip chip--green chip--small">Global</p>
              <h3>Languages</h3>
              <p>
                Luxel is available in 11 languages, including the app interface and privacy
                permission prompts.
              </p>
              <ul class="tag-list" aria-label="Available languages">
                {languages.map((language) => <li>{language}</li>)}
              </ul>
            </article>
          </div>
        </section>

        <section class="section container" id="notch" aria-labelledby="notch-title">
          <div class="section__head">
            <p class="eyebrow">Recording controls</p>
            <h2 class="section__title" id="notch-title">The notch becomes your recorder.</h2>
            <p class="section__lead">
              Luxel keeps recording state where your eyes already go: timer, waveform, and stop
              control stay close at hand.
            </p>
          </div>
          <div class="notch-scene" aria-label="Luxel notch capture controls below the menu bar">
            <div class="notch-scene__menubar" aria-hidden="true">
              <div class="notch-scene__cluster">
                <img src="/luxel-icon.svg" alt="" width="15" height="15" />
                <span class="notch-scene__app">Luxel</span>
                <span>File</span><span>Edit</span><span>View</span>
              </div>
              <div class="notch-scene__cluster">
                <span class="live-dot live-dot--menubar"></span>
                <span>Tue 23:30</span>
              </div>
            </div>
            <div class="notch-scene__notch" aria-hidden="true"></div>
            <div class="notch-scene__body">
              <img
                src="/screenshots/luxel-notch-controls.png"
                alt="Luxel notch capture controls"
                width="632"
                height="308"
                loading="lazy"
              />
            </div>
          </div>
        </section>

        <section class="duo container" aria-label="Menu bar status and audio transcripts">
          <article class="glass-card duo__card" id="recording-status">
            <p class="eyebrow">Menu bar status</p>
            <h3>Active recordings stay visible.</h3>
            <p>
              When recording starts, Luxel switches the menu bar into a compact live state with the
              recording indicator, waveform, elapsed time, and stop control always close at hand.
            </p>
            <img
              src="/screenshots/luxel-menu-bar-recording-status.png"
              alt="Luxel active recording state in the menu bar with indicator, waveform, elapsed time, and stop control"
              width="1162"
              height="736"
              loading="lazy"
            />
          </article>
          <article class="glass-card duo__card" id="audio-transcripts">
            <p class="eyebrow">Audio transcripts</p>
            <h3>Audio files stay searchable.</h3>
            <p>
              Open audio-only recordings in the editor with local transcripts, search within the
              text, and keep playback, export, and transcript review in one workspace.
            </p>
            <img
              src="/screenshots/luxel-audio-transcript-editor.png"
              alt="Luxel editor with searchable audio transcript"
              width="2224"
              height="1648"
              loading="lazy"
            />
          </article>
        </section>

        <section class="section container" id="agents" aria-labelledby="agents-title">
          <div class="banner banner--agents">
            <div>
              <p class="eyebrow">Agent ready</p>
              <h2 class="banner__title" id="agents-title">Your agent can run the recorder.</h2>
              <p class="banner__lead">
                Any LLM or agent that can run a shell command can start captures, stop recordings,
                make replay clips, and open results or settings — with structured callbacks it can
                actually read.
              </p>
              <ul class="points">
                {agentPoints.map((point) => <li>{point}</li>)}
              </ul>
              <a class="glass-button banner__cta" href="/docs#cli">CLI reference →</a>
            </div>
            <div class="terminal" aria-label="Example agent session in a terminal">
              <div class="terminal__bar">
                <span class="terminal__dot terminal__dot--close" aria-hidden="true"></span>
                <span class="terminal__dot terminal__dot--min" aria-hidden="true"></span>
                <span class="terminal__dot terminal__dot--max" aria-hidden="true"></span>
                <span class="terminal__label">agent session</span>
              </div>
              <div class="terminal__body">
                <div class="terminal__comment"># agent: reproduce the bug and report back</div>
                <div><span class="code-prompt">$</span> luxel record --display main --fps display --countdown 3</div>
                <div><span class="code-prompt">$</span> luxel stop</div>
                <div><span class="code-prompt">$</span> luxel clip --seconds 30 --wait</div>
                <div><span class="code-prompt">$</span> luxel latest --reveal</div>
                <div class="terminal__result">&#123;"status":"success","filePath":"~/Movies/Luxel/Luxel Replay 2026-07-08 at 00.12.30.mp4"&#125;</div>
              </div>
            </div>
          </div>
        </section>

        <section class="section container" id="local" aria-labelledby="local-title">
          <div class="banner banner--local">
            <div>
              <p class="eyebrow">Local by design</p>
              <h2 class="banner__title" id="local-title">No watermarks. No tracking.</h2>
              <p class="banner__lead">
                Luxel records, edits, transcribes, and exports locally on your Mac without
                restricting the files you make or uploading your work.
              </p>
            </div>
            <ul class="check-list" aria-label="Local app promises">
              {localPoints.map((point) => (
                <li>
                  <span class="check-list__badge" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l5 5 10-11"></path></svg>
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="section section--center container" id="export" aria-labelledby="export-title">
          <div class="section__head">
            <p class="eyebrow">Export</p>
            <h2 class="section__title" id="export-title">Fast files. Clean choices.</h2>
            <p class="section__lead">
              With fast exports plus WebM and AV1 support, Luxel keeps video, animation, and
              audio-only formats close without turning the recorder into an editor you have to
              manage.
            </p>
          </div>
          <ul class="format-list" aria-label="Export formats">
            {exportFormats.map((format) => <li>{format}</li>)}
          </ul>
        </section>

        <section class="footer-cta container" aria-labelledby="docs-title">
          <div class="banner banner--cta">
            <p class="eyebrow">Documentation</p>
            <h2 class="banner__title banner__title--center" id="docs-title">
              Capture, export, and troubleshoot with confidence.
            </h2>
            <div class="footer-cta__actions">
              <a
                class="app-store-link"
                href={macAppStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download Luxel on the Mac App Store"
              >
                <img
                  src="/app-store/mac-app-store-badge.svg"
                  alt="Download on the Mac App Store"
                  width="149"
                  height="46"
                />
              </a>
              <a class="button button--primary" href="/docs">Open docs</a>
              <a class="glass-button" href="/privacy">Privacy</a>
              <a class="glass-button" href="/support">Support</a>
            </div>
          </div>
        </section>
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

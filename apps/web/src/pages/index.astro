---
import "../styles/global.css";

const featureColumns = [
  {
    title: "Capture",
    text: "Record displays, windows, selected areas, audio, and camera overlays from a native menu bar surface."
  },
  {
    title: "Replay Buffer",
    text: "Keep recent screen history ready, then export the last 30 seconds, 1 minute, 2 minutes, or 5 minutes."
  },
  {
    title: "CLI and Automation",
    text: "Run captures, clips, exports, transcripts, callbacks, and settings workflows from scripts."
  }
];

const exportFormats = ["MP4", "HEVC", "ProRes", "GIF", "APNG", "WebM"];

const primaryFeatures = [
  {
    id: "capture",
    eyebrow: "Record",
    title: "Menu bar capture",
    text: "Start display, window, area, and audio-only recordings from the menu bar. Luxel keeps target selection, audio toggles, permission status, recent files, and quick recording controls close without opening a full app window.",
    image: {
      src: "/screenshots/luxel-menu-capture.png",
      alt: "Luxel menu bar capture panel with source, replay buffer, recent clip, audio, microphone, camera, and more controls."
    },
    points: ["Display, window, and selected-area targets", "System audio, microphone, and audio-only capture", "Countdown, auto-stop, pause, resume, and recent recording actions"]
  },
  {
    id: "replay-buffer",
    eyebrow: "Recover",
    title: "Replay buffer",
    text: "Turn on the replay buffer when you need to capture what just happened. Luxel records a rolling ScreenCaptureKit buffer and exports a replay clip without interrupting the buffer.",
    image: {
      src: "/screenshots/luxel-settings-replay-buffer.png",
      alt: "Luxel Replay Buffer settings with length, source, frame rate, audio, and clip destination controls."
    },
    points: ["30 second, 1 minute, 2 minute, and 5 minute buffers", "24 or 30 FPS with optional system audio", "Clip to the editor or a configured quick export destination"]
  },
  {
    id: "editor-export",
    eyebrow: "Polish",
    title: "Editor and export",
    text: "Open recordings in the editor to trim, resize, retime, crop-to-fill, mute, copy frames, save originals, and export through native macOS media paths plus Luxel's native WebM adapter.",
    image: {
      src: "/screenshots/luxel-editor-loaded.png",
      alt: "Luxel editor window with a loaded desktop clip and export format, timeline, and output panels open."
    },
    points: ["MP4, HEVC MP4, ProRes 422, ProRes 4444, GIF, APNG, and WebM", "Compact, Balanced, High, and format-aware quality controls", "Batch exports, Finder actions, copy path, copy file, and Share"]
  },
  {
    id: "transcripts",
    eyebrow: "Text",
    title: "Local transcripts",
    text: "Transcribe recordings locally with Apple Speech, preview transcript progress in the editor, and choose raw or Apple Intelligence turn segmentation for easier review.",
    image: {
      src: "/screenshots/luxel-settings-recording.png",
      alt: "Luxel recording settings with capture, audio, and camera controls."
    },
    points: ["Plain text or JSON transcript output from the CLI", "Locale selection for command-line transcription", "Transcript caching and editor transcript workflows"]
  },
  {
    id: "cli",
    eyebrow: "Automate",
    title: "Command line and URL control",
    text: "Install the bundled luxel command from Settings and control Luxel from shell scripts, launchers, URL automation, or Shortcuts.",
    image: {
      src: "/screenshots/luxel-cli-convert-progress.png",
      alt: "Luxel command line converting an MP4 file to WebM with a terminal progress bar."
    },
    points: ["record, stop, toggle, clip, latest, editor, convert, export, transcribe, preferences", "x-success and x-error callbacks with --wait, --json, and --print-url", "Headless trim, resize, speed, quality, crop, mute, and format conversion"]
  },
  {
    id: "localization",
    eyebrow: "Global",
    title: "Native localization",
    text: "Luxel now ships native macOS localization resources for the app interface and privacy permission prompts across 11 locales.",
    points: ["English, German, Spanish, French, Italian, Japanese, Korean, Vietnamese", "Simplified Chinese, Portuguese (Brazil), and Portuguese (Portugal)", "Localized permission copy for camera, microphone, screen capture, and speech recognition"]
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Luxel is a native macOS menu bar recorder for screen capture, replay buffer clips, local transcripts, command-line automation, and polished exports."
    />
    <meta name="apple-itunes-app" content="app-id=6780682473" />
    <link rel="icon" href="/luxel-icon.svg" type="image/svg+xml" />
    <title>Luxel - Native capture for Mac</title>
  </head>
  <body>
    <main class="site-shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__atmosphere" aria-hidden="true">
          <span class="coast coast--left"></span>
          <span class="coast coast--right"></span>
          <span class="lightline"></span>
        </div>

        <header class="topbar" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Luxel home">
            <img class="brand-mark" src="/luxel-icon.svg" alt="" width="48" height="48" />
            <span>Luxel</span>
          </a>
          <nav class="nav-links" aria-label="Page sections">
            <a href="#features">Features</a>
            <a href="#replay-buffer">Replay Buffer</a>
            <a href="#cli">CLI</a>
            <a href="#notch">Notch</a>
            <a href="/docs">Docs</a>
          </nav>
          <a class="topbar-cta" href="/docs">Read docs</a>
        </header>

        <div class="hero__content">
          <div class="hero-copy">
            <p class="eyebrow">Menu bar recorder for macOS</p>
            <h1 id="hero-title">Luxel</h1>
            <p class="hero-copy__lead">Native capture for Mac.</p>
            <p class="hero-copy__body">
              Record screens, clip the last few minutes, transcribe locally, automate from the CLI,
              and export without ceremony.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button--primary" href="/docs">Read docs</a>
              <a class="button button--ghost" href="#notch">
                <span class="play-icon" aria-hidden="true"></span>
                See capture surface
              </a>
            </div>
          </div>

          <div class="hero-product hero-product--real" aria-label="Actual Luxel app screenshots">
            <img
              class="hero-screenshot hero-screenshot--settings"
              src="/screenshots/luxel-settings-replay-buffer.png"
              alt="Actual Luxel Replay Buffer settings window."
              width="1800"
              height="1384"
            />
            <img
              class="hero-screenshot hero-screenshot--menu"
              src="/screenshots/luxel-menu-capture.png"
              alt="Actual Luxel menu bar capture panel with bottom audio, microphone, camera, and more controls."
              width="640"
              height="674"
            />
          </div>
        </div>

        <div class="feature-band" id="features">
          {featureColumns.map((feature) => (
            <article class="feature-band__item">
              <span class="feature-glyph" aria-hidden="true"></span>
              <div>
                <h2>{feature.title}</h2>
                <p>{feature.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="primary-features-section" id="primary-features" aria-labelledby="primary-features-title">
        <div class="section-copy">
          <p class="eyebrow">Primary features</p>
          <h2 id="primary-features-title">Everything Luxel can do, in one native Mac workflow.</h2>
          <p>
            The app now covers capture, replay, export, transcripts, automation, and localization
            without leaving native macOS frameworks.
          </p>
        </div>

        <div class="primary-feature-grid">
          {primaryFeatures.map((feature) => (
            <article class="primary-feature-card" id={feature.id}>
              <p class="primary-feature-card__eyebrow">{feature.eyebrow}</p>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
              {"image" in feature && (
                <img
                  class={`primary-feature-card__media${feature.id === "capture" ? " primary-feature-card__media--menu" : ""}`}
                  src={feature.image.src}
                  alt={feature.image.alt}
                  loading="lazy"
                />
              )}
              <ul>
                {feature.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="notch-section" id="notch" aria-labelledby="notch-title">
        <div class="section-copy">
          <p class="eyebrow">Capture surface</p>
          <h2 id="notch-title">The notch becomes your recorder.</h2>
          <p>
            Luxel keeps recording state where your eyes already go: timer, waveform,
            stop control, quick exports, and finished files live in one glanceable surface.
          </p>
        </div>
        <div class="notch-media" aria-label="Luxel notch capture controls">
          <img
            class="notch-image"
            src="/screenshots/luxel-notch-ui-with-black-top-bar.png"
            alt="Luxel notch capture controls below a black notch bar."
            width="492"
            height="196"
            loading="lazy"
          />
        </div>
      </section>

      <section class="recording-status-section" id="recording-status" aria-labelledby="recording-status-title">
        <div class="section-copy">
          <p class="eyebrow">Menu bar status</p>
          <h2 id="recording-status-title">Active recordings stay visible.</h2>
          <p>
            When recording starts, Luxel switches the menu bar into a compact live state
            with the recording indicator, waveform, elapsed time, and stop control always
            close at hand.
          </p>
        </div>
        <figure class="recording-status-media" aria-label="Luxel menu bar active recording state">
          <img
            class="recording-menu-bar-image"
            src="/screenshots/luxel-active-recording-menu-bar.png"
            alt="Luxel menu bar active recording state with red recording dot, waveform, timer, and stop button."
            width="778"
            height="64"
            loading="lazy"
          />
        </figure>
      </section>

      <section class="export-section" id="export" aria-labelledby="export-title">
        <div class="section-copy">
          <p class="eyebrow">Native export</p>
          <h2 id="export-title">Fast files. Clean choices.</h2>
          <p>
            Built around native macOS capture and export paths with WebM support, Luxel
            keeps common formats close without turning the recorder into an editor you
            have to manage.
          </p>
        </div>
        <ul class="format-list" aria-label="Export formats">
          {exportFormats.map((format) => <li>{format}</li>)}
        </ul>
      </section>

      <section class="docs-cta-section" id="docs" aria-labelledby="docs-title">
        <div>
          <p class="eyebrow">Documentation</p>
          <h2 id="docs-title">Capture, export, and troubleshoot with confidence.</h2>
        </div>
        <a class="button button--primary" href="/docs">
          Open docs
        </a>
      </section>
    </main>
  </body>
</html>

---
import "../styles/global.css";

const featureColumns = [
  {
    title: "Capture",
    text: "Record displays, windows, selected areas, audio, and camera overlays with cursor, click, countdown, and auto-stop controls."
  },
  {
    title: "Replay Buffer",
    text: "Keep recent screen history ready, then export the last 30 seconds, 1 minute, 2 minutes, or 5 minutes."
  },
  {
    title: "CLI and Automation",
    text: "Run captures, clips, exports, transcripts, callbacks, settings, and URL workflows from scripts."
  }
];

const exportFormats = ["MP4", "HEVC", "ProRes", "GIF", "APNG", "WebM", "M4A", "WAV", "FLAC"];
const macAppStoreUrl = "https://apps.apple.com/us/app/luxel/id6780682473?mt=12";

const localPromisePoints = [
  "No watermarks, time limits, or export restrictions.",
  "No tracking, analytics, or cloud recording pipeline.",
  "Runs offline and does not require internet access.",
  "Every feature is available without paid upgrades."
];

const primaryFeatures = [
  {
    id: "capture",
    eyebrow: "Record",
    title: "Menu bar capture",
    text: "Start display, window, area, and audio-only recordings from the menu bar. Luxel keeps target selection, audio toggles, cursor visibility, click highlights, permission status, recent files, and quick recording controls close without opening a full app window.",
    image: {
      src: "/screenshots/luxel-menu-capture.png",
      alt: "Luxel menu bar capture panel with source, replay buffer, recent clip, audio, microphone, camera, and more controls."
    },
    points: ["Display, window, and selected-area targets", "System audio, microphone, camera preview, and audio-only capture", "1-60 FPS, countdown, auto-stop, pause, resume, and recent recording actions"]
  },
  {
    id: "replay-buffer",
    eyebrow: "Recover",
    title: "Replay buffer",
    text: "Turn on the replay buffer when you need to capture what just happened. Luxel records a rolling ScreenCaptureKit buffer and exports a replay clip without interrupting the buffer.",
    image: {
      src: "/screenshots/luxel-settings-replay-buffer.png",
      alt: "Luxel Replay Buffer settings with length, source, frame rate, audio, and clip destination controls."
    },
    points: ["30 second, 1 minute, 2 minute, and 5 minute buffers", "24 or 30 FPS with optional system audio", "Clip to the editor or a configured quick export destination"]
  },
  {
    id: "editor-export",
    eyebrow: "Polish",
    title: "Editor and export",
    text: "Open recordings in the editor to trim, resize, retime, crop-to-fill, adjust audio, copy frames, save originals, and export through native macOS media paths plus Luxel's native WebM adapter.",
    image: {
      src: "/screenshots/luxel-editor-loaded.png",
      alt: "Luxel editor window with a loaded desktop clip and export format, timeline, and output panels open."
    },
    points: ["MP4, HEVC MP4, ProRes 422, ProRes 4444, GIF, APNG, WebM, and audio-only exports", "Compact, Balanced, High, lossless, size estimates, level, and normalize controls", "Multi-format batches, Finder actions, copy path, copy file, and Share"]
  },
  {
    id: "transcripts",
    eyebrow: "Text",
    title: "Local transcripts",
    text: "Transcribe recordings locally with Apple Speech, search and jump through transcript text in the editor, and choose raw or Apple Intelligence turn segmentation for easier review.",
    image: {
      src: "/screenshots/luxel-audio-transcript-editor.png",
      alt: "Luxel editor showing an audio file with searchable transcript text, highlighted segments, playback controls, and audio export settings."
    },
    points: ["Plain text or JSON transcript output from the CLI", "Locale selection and semantic turn segmentation", "Transcript caching, search, and editor transcript workflows"]
  },
  {
    id: "cli",
    eyebrow: "Automate",
    title: "Command line and URL control",
    text: "Install the bundled luxel command from Settings and control Luxel from shell scripts, launchers, URL automation, or Shortcuts.",
    video: {
      src: "/videos/luxel-cli-usage-demo.webm",
      label: "Luxel command-line usage recording showing terminal commands and generated export output.",
      width: 740,
      height: 470,
      note: "This CLI walkthrough was recorded, edited, and exported using Luxel itself."
    },
    points: ["record, stop, toggle, clip, latest, editor, convert, export, transcribe, preferences", "x-success and x-error callbacks with --wait, --json, and --print-url", "Headless trim, resize, speed, quality, crop, mute, and format conversion"]
  },
  {
    id: "settings-shortcuts",
    eyebrow: "Control",
    title: "Settings, shortcuts, and presets",
    text: "Tune Luxel for repeated work with editable global shortcuts, quick export presets, reusable crop sizes, command-line installation, update controls, and replay buffer behavior.",
    points: ["Searchable global shortcuts with conflict warnings", "Quick Recording presets with size, frame rate, destination, and post-action", "Recording, output, notch, replay buffer, command-line, and system settings"]
  },
  {
    id: "localization",
    eyebrow: "Global",
    title: "Native localization",
    text: "Luxel now ships native macOS localization resources for the app interface and privacy permission prompts across 11 locales.",
    points: ["English, German, Spanish, French, Italian, Japanese, Korean, Vietnamese", "Simplified Chinese, Portuguese (Brazil), and Portuguese (Portugal)", "Localized permission copy for camera, microphone, screen capture, and speech recognition"]
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Luxel is a native macOS menu bar recorder for screen capture, replay buffer clips, local transcripts, command-line automation, and polished exports."
    />
    <meta name="apple-itunes-app" content="app-id=6780682473" />
    <link rel="icon" href="/luxel-icon.svg" type="image/svg+xml" />
    <link rel="alternate" href="/llms.txt" type="text/markdown" title="Luxel LLM-readable index" />
    <link rel="alternate" href="/llms-full.txt" type="text/markdown" title="Luxel full Markdown documentation" />
    <title>Luxel - Native capture for Mac</title>
  </head>
  <body>
    <main class="site-shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__atmosphere" aria-hidden="true">
          <span class="coast coast--left"></span>
          <span class="coast coast--right"></span>
          <span class="lightline"></span>
        </div>

        <header class="topbar" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Luxel home">
            <img class="brand-mark" src="/luxel-icon.svg" alt="" width="48" height="48" />
            <span>Luxel</span>
          </a>
          <nav class="nav-links" aria-label="Page sections">
            <a href="#features">Features</a>
            <a href="#replay-buffer">Replay Buffer</a>
            <a href="#cli">CLI</a>
            <a href="#notch">Notch</a>
            <a href="/docs">Docs</a>
            <a href="/privacy">Privacy</a>
          </nav>
          <a class="topbar-cta" href="/docs">Read docs</a>
        </header>

        <div class="hero__content">
          <div class="hero-copy">
            <p class="eyebrow">Menu bar recorder for macOS</p>
            <h1 id="hero-title">Luxel</h1>
            <p class="hero-copy__lead">Native capture for Mac.</p>
            <p class="hero-copy__body">
              Record screens, clip the last few minutes, transcribe locally, automate from the CLI,
              and export without ceremony.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <a
                class="app-store-link"
                href={macAppStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download Luxel on the Mac App Store"
              >
                <img
                  class="app-store-badge"
                  src="/app-store/mac-app-store-badge.svg"
                  alt="Download on the Mac App Store"
                  width="156"
                  height="40"
                />
              </a>
              <a class="button button--primary" href="/docs">Read docs</a>
              <a class="button button--ghost" href="#notch">
                <span class="play-icon" aria-hidden="true"></span>
                See capture surface
              </a>
            </div>
          </div>

          <div class="hero-product hero-product--real" aria-label="Actual Luxel app screenshots">
            <img
              class="hero-screenshot hero-screenshot--settings"
              src="/screenshots/luxel-settings-replay-buffer.png"
              alt="Actual Luxel Replay Buffer settings window."
              width="1800"
              height="1384"
            />
            <img
              class="hero-screenshot hero-screenshot--menu"
              src="/screenshots/luxel-menu-capture.png"
              alt="Actual Luxel menu bar capture panel with bottom audio, microphone, camera, and more controls."
              width="640"
              height="674"
            />
          </div>
        </div>

        <div class="feature-band" id="features">
          {featureColumns.map((feature) => (
            <article class="feature-band__item">
              <span class="feature-glyph" aria-hidden="true"></span>
              <div>
                <h2>{feature.title}</h2>
                <p>{feature.text}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="local-promise-section" aria-labelledby="local-promise-title">
        <div class="local-promise-inner">
          <div class="local-promise-copy">
            <p class="eyebrow">Local by design</p>
            <h2 id="local-promise-title">No watermarks. No tracking. No upgrade gates.</h2>
          </div>
          <p>
            Luxel runs on your Mac without restricting the files you make. Capture, replay,
            transcribe, automate, and export without sending work to a service or unlocking
            core features later.
          </p>
          <ul aria-label="Local app promises">
            {localPromisePoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>

      <section class="primary-features-section" id="primary-features" aria-labelledby="primary-features-title">
        <div class="section-copy">
          <p class="eyebrow">Primary features</p>
          <h2 id="primary-features-title">Everything Luxel can do, in one native Mac workflow.</h2>
          <p>
            The app now covers capture, replay, export, transcripts, automation, and localization
            without leaving native macOS frameworks.
          </p>
        </div>

        <div class="primary-feature-grid">
          {primaryFeatures.map((feature) => (
            <article class={`primary-feature-card${"image" in feature || "video" in feature ? "" : " primary-feature-card--text-only"}`} id={feature.id}>
              <div class="primary-feature-card__copy">
                <p class="primary-feature-card__eyebrow">{feature.eyebrow}</p>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
                <ul>
                  {feature.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              {"image" in feature && (
                <img
                  class={`primary-feature-card__media${feature.id === "capture" ? " primary-feature-card__media--menu" : ""}`}
                  src={feature.image.src}
                  alt={feature.image.alt}
                  loading="lazy"
                />
              )}
              {"video" in feature && (
                <figure class="primary-feature-card__figure">
                  <video
                    class="primary-feature-card__media primary-feature-card__media--video js-lazy-video"
                    data-lazy-src={feature.video.src}
                    aria-label={feature.video.label}
                    width={feature.video.width}
                    height={feature.video.height}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  ></video>
                  <figcaption>{feature.video.note}</figcaption>
                </figure>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="notch-section" id="notch" aria-labelledby="notch-title">
        <div class="section-copy">
          <p class="eyebrow">Capture surface</p>
          <h2 id="notch-title">The notch becomes your recorder.</h2>
          <p>
            Luxel keeps recording state where your eyes already go: timer, waveform,
            and stop control live in one glanceable surface.
          </p>
        </div>
        <div class="notch-media" aria-label="Luxel notch capture controls">
          <img
            class="notch-image"
            src="/screenshots/luxel-notch-ui-with-black-top-bar.png"
            alt="Luxel notch capture controls below a black notch bar."
            width="492"
            height="196"
            loading="lazy"
          />
        </div>
      </section>

      <section class="recording-status-section" id="recording-status" aria-labelledby="recording-status-title">
        <div class="section-copy">
          <p class="eyebrow">Menu bar status</p>
          <h2 id="recording-status-title">Active recordings stay visible.</h2>
          <p>
            When recording starts, Luxel switches the menu bar into a compact live state
            with the recording indicator, waveform, elapsed time, and stop control always
            close at hand.
          </p>
        </div>
        <figure class="recording-status-media" aria-label="Luxel menu bar active recording state">
          <video
            class="recording-menu-bar-image"
            src="/videos/luxel-active-recording-menu-bar.webm"
            aria-label="Luxel menu bar active recording state with red recording dot, waveform, timer, and stop button."
            width="912"
            height="66"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
        </figure>
      </section>

      <section class="audio-transcript-section" id="audio-transcripts" aria-labelledby="audio-transcript-title">
        <div class="section-copy">
          <p class="eyebrow">Audio transcripts</p>
          <h2 id="audio-transcript-title">Audio files stay searchable.</h2>
          <p>
            Open audio-only recordings in the editor with local transcripts, search within the
            text, and keep playback, export, and transcript review in one workspace.
          </p>
        </div>
        <figure class="audio-transcript-media" aria-label="Luxel audio editor with transcript search and highlighted transcript segment">
          <img
            class="audio-transcript-image"
            src="/screenshots/luxel-audio-transcript-editor.png"
            alt="Luxel editor showing an audio file with a searchable transcript, highlighted transcript text, playback controls, and audio export settings."
            width="2224"
            height="1648"
            loading="lazy"
          />
        </figure>
      </section>

      <section class="export-section" id="export" aria-labelledby="export-title">
        <div class="section-copy">
          <p class="eyebrow">Native export</p>
          <h2 id="export-title">Fast files. Clean choices.</h2>
          <p>
            Built around native macOS capture and export paths with WebM support, Luxel
            keeps video, animation, and audio-only formats close without turning the
            recorder into an editor you have to manage.
          </p>
        </div>
        <ul class="format-list" aria-label="Export formats">
          {exportFormats.map((format) => <li>{format}</li>)}
        </ul>
      </section>

      <section class="docs-cta-section" id="docs" aria-labelledby="docs-title">
        <div>
          <p class="eyebrow">Documentation</p>
          <h2 id="docs-title">Capture, export, and troubleshoot with confidence.</h2>
        </div>
        <div class="docs-cta-actions">
          <a class="button button--primary" href="/docs">
            Open docs
          </a>
          <a class="button button--secondary" href="/privacy">
            Privacy
          </a>
        </div>
      </section>
    </main>
    <script>
      const lazyVideos = Array.from(document.querySelectorAll("video[data-lazy-src]"));

      const loadLazyVideo = (video) => {
        if (!(video instanceof HTMLVideoElement) || video.src) {
          return;
        }

        const src = video.dataset.lazySrc;
        if (!src) {
          return;
        }

        video.src = src;
        video.load();
        video.play().catch(() => {});
      };

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) {
                return;
              }

              loadLazyVideo(entry.target);
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "420px 0px" }
        );

        lazyVideos.forEach((video) => observer.observe(video));
      } else {
        lazyVideos.forEach(loadLazyVideo);
      }
    </script>
  </body>
</html>

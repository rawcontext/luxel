---
import PageLayout from "../components/PageLayout.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<PageLayout
  title="Support - Luxel"
  description="Contact Luxel support with a bug report, feature request, or product question."
  bodyClass="support-page"
  navigationLabel="Support page navigation"
>
  {turnstileSiteKey && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

      <main class="support-shell container">
        <section class="support-hero" aria-labelledby="support-title">
          <p class="eyebrow">Support</p>
          <h1 class="support-title page-title gradient-title" id="support-title">Send a bug report or request.</h1>
          <p class="support-lead">
            Send a bug report, feature request, or product question with the email address where
            we can follow up.
          </p>
        </section>

        <section class="support-card" aria-labelledby="support-form-title" data-support-form-section>
          <div class="support-card__head">
            <p class="eyebrow">Contact</p>
            <h2 id="support-form-title">Tell us what happened.</h2>
            <p>We read every message and will reply when a follow-up is needed.</p>
          </div>

          <form class="support-form" method="post" action="/api/support" data-support-form>
            <label>
              <span>Email address</span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                maxlength="254"
                required
              />
            </label>

            <label>
              <span>Message</span>
              <textarea name="message" rows="9" maxlength="8000" required></textarea>
            </label>

            {
              turnstileSiteKey ? (
                <div class="turnstile-field">
                  <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                </div>
              ) : (
                <p class="support-form__status" role="status">
                  Support submissions are not configured yet.
                </p>
              )
            }

            <button class="button button--primary" type="submit" disabled={!turnstileSiteKey}>
              Send message
            </button>
            <p class="support-form__status" role="status" data-support-status></p>
          </form>
        </section>

        <section class="support-card support-success" aria-labelledby="support-success-title" tabindex="-1" data-support-success hidden>
          <p class="eyebrow">Submitted</p>
          <h2 id="support-success-title">Thank you for your submission.</h2>
          <p>We received your message and will follow up by email if needed.</p>
          <p class="support-success__redirect">Redirecting you back to the homepage shortly.</p>
          <a class="glass-button" href="/">Return home</a>
        </section>
      </main>

    <script>
      const supportForm = document.querySelector("[data-support-form]");
      const supportStatus = document.querySelector("[data-support-status]");
      const supportFormSection = document.querySelector("[data-support-form-section]");
      const supportSuccess = document.querySelector("[data-support-success]");

      if (supportForm instanceof HTMLFormElement && supportStatus instanceof HTMLElement) {
        supportForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          const submitButton = supportForm.querySelector("button[type='submit']");
          if (!(submitButton instanceof HTMLButtonElement)) {
            return;
          }

          submitButton.disabled = true;
          supportStatus.textContent = "Sending...";

          try {
            const response = await fetch(supportForm.action, {
              method: "POST",
              body: new FormData(supportForm),
              headers: {
                Accept: "application/json"
              }
            });

            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
              throw new Error(payload.message || "Could not send the report.");
            }

            if (supportFormSection instanceof HTMLElement && supportSuccess instanceof HTMLElement) {
              supportFormSection.hidden = true;
              supportSuccess.hidden = false;
              supportSuccess.focus();
              window.setTimeout(() => {
                window.location.assign("/");
              }, 5000);
            } else {
              supportStatus.textContent = payload.message || "Thank you for your submission.";
            }
          } catch (error) {
            window.turnstile?.reset();
            supportStatus.textContent = error instanceof Error ? error.message : "Could not send the report.";
          } finally {
            submitButton.disabled = false;
          }
        });
      }
    </script>
</PageLayout>

<style>
  .support-shell {
    width: min(100%, 45rem);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
  }

  .support-hero {
    margin-block-end: 40px;
    text-align: center;
  }

  .support-lead {
    max-width: 34rem;
    margin: 18px auto 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .support-card {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: 26px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.04)),
      rgb(28 28 40 / 0.46);
    backdrop-filter: blur(38px) saturate(185%);
    -webkit-backdrop-filter: blur(38px) saturate(185%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      inset 0 -1px 0 rgb(255 255 255 / 0.05),
      inset 0 0 0 1px rgb(255 255 255 / 0.07),
      0 28px 68px rgb(0 0 0 / 0.46);
  }

  .support-card::before,
  .support-card::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: "";
    border-radius: inherit;
    pointer-events: none;
  }

  .support-card::before {
    background:
      radial-gradient(120% 90% at 50% -20%, rgb(255 255 255 / 0.18), transparent 52%),
      linear-gradient(105deg, rgb(255 255 255 / 0.1), transparent 42% 70%, rgb(143 134 255 / 0.1));
  }

  .support-card::after {
    inset: 1px;
    background: radial-gradient(120% 140% at 50% 130%, rgb(0 0 0 / 0.28), transparent 52%);
    opacity: 0.8;
  }

  .support-card > * {
    position: relative;
    z-index: 1;
  }

  .support-card h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.018em;
  }

  .support-card__head {
    margin-block-end: 26px;
  }

  .support-card__head p:not(.eyebrow) {
    margin-block-start: 10px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .support-form {
    display: grid;
    gap: 18px;
  }

  .support-form label {
    display: grid;
    gap: 8px;
  }

  .support-form label span {
    color: rgb(255 255 255 / 0.85);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .support-form input,
  .support-form textarea {
    width: 100%;
    border: 0;
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.025)),
      rgb(0 0 0 / 0.25);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: var(--ink);
    font: inherit;
    transition: box-shadow 150ms ease;
  }

  .support-form input {
    min-height: 3.1rem;
    padding-inline: 1rem;
  }

  .support-form textarea {
    min-height: 12rem;
    padding: 0.9rem 1rem;
    resize: vertical;
  }

  .support-form input:focus,
  .support-form textarea:focus {
    outline: 0;
    box-shadow:
      inset 0 0 0 1px rgb(143 134 255 / 0.7),
      0 0 0 3px rgb(143 134 255 / 0.18);
  }

  .turnstile-field {
    min-height: 4.1rem;
  }

  .support-form .button {
    justify-self: start;
    min-width: 10rem;
    text-align: center;
  }

  .support-form .button:disabled {
    opacity: 0.55;
    transform: none;
  }

  .support-form__status {
    min-height: 1.4rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .support-success {
    text-align: center;
    outline: 0;
  }

  .support-success h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .support-success p:not(.eyebrow) {
    margin-block-start: 12px;
    color: var(--muted);
  }

  .support-success__redirect {
    font-size: 0.92rem;
  }

  .support-success .glass-button {
    margin-block-start: 22px;
  }

  @media (max-width: 620px) {
    .support-form .button {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>

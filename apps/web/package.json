{
  "name": "@luxel/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-llms.mjs",
    "i18n:extract": "node scripts/extract-i18n-sources.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "test": "node scripts/extract-i18n-sources.mjs --check && bun test && sh scripts/test-installer.sh dist/client/cli/install.sh",
    "test:installer": "sh scripts/test-installer.sh dist/client/cli/install.sh",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.7",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}

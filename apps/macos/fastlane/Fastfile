# frozen_string_literal: true

require "base64"
require "fileutils"
require "securerandom"
require "shellwords"

default_platform(:mac)

APP_IDENTIFIER = "com.rawcontext.luxel"
APPLE_TEAM_ID = "U65DCW9TAK"
REPO_ROOT = File.expand_path("..", __dir__)
PACKAGE_PATH = File.join(REPO_ROOT, ".build/mas/Luxel.pkg")
APP_STORE_PROFILE_NAME = "Luxel Mac App Store"
TIME_SENSITIVE_NOTIFICATIONS_CAPABILITY = "USERNOTIFICATIONS_TIMESENSITIVE"

platform :mac do
  desc "Build a Mac App Store package for Luxel"
  lane :build_testflight_pkg do |options|
    signing_assets = prepare_signing_assets
    build_testflight_package(options, signing_assets)
  end

  desc "Build Luxel and upload the signed macOS package to TestFlight"
  lane :release_testflight do |options|
    api_key = app_store_connect_api_key_from_env
    signing_assets = prepare_signing_assets
    pkg_path = build_testflight_package(options, signing_assets)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "osx",
      pkg: pkg_path,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false,
      changelog: testflight_changelog(options)
    )
  end

  desc "Enable Time Sensitive Notifications and refresh the Mac App Store profile"
  lane :refresh_app_store_profile do |options|
    api_key = app_store_connect_api_key_from_env
    ensure_time_sensitive_notifications_capability!
    import_signing_certificates

    output_path = options[:output_path] || ENV["MAC_APP_STORE_PROFILE_OUTPUT_PATH"]
    UI.user_error!("Missing output_path or MAC_APP_STORE_PROFILE_OUTPUT_PATH") if output_path.to_s.strip == ""
    output_path = File.expand_path(output_path.to_s, REPO_ROOT)
    FileUtils.mkdir_p(output_path)

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: APPLE_TEAM_ID,
      platform: "macos",
      provisioning_name: APP_STORE_PROFILE_NAME,
      force: true,
      skip_install: true,
      output_path: output_path,
      filename: "Luxel_Mac_App_Store.mobileprovision"
    )
  end

  desc "Update App Review notes and submit an existing build for automatic release without a phased rollout"
  lane :submit_app_store_release do |options|
    app_version = app_store_version(options)
    build_number = app_store_build_number(options)
    api_key = app_store_connect_api_key_from_env

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("Could not find App Store Connect app #{APP_IDENTIFIER}") unless app
    app.ensure_version!(app_version, platform: Spaceship::ConnectAPI::Platform::MAC_OS)

    version = app.get_app_store_versions(
      filter: { versionString: app_version, platform: Spaceship::ConnectAPI::Platform::MAC_OS },
      includes: "appStoreVersionPhasedRelease"
    ).find { |candidate| candidate.version_string == app_version }
    UI.user_error!("Could not find macOS App Store version #{app_version}") unless version
    update_app_review_notes!(version)
    apply_app_store_release_policy!(version)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload localized metadata to an editable App Store Connect version"
  lane :sync_app_store_metadata do |options|
    upload_to_app_store(
      api_key: app_store_connect_api_key_from_env,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version(options),
      metadata_path: app_store_metadata_path(options),
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      edit_live: false,
      use_live_version: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload localized screenshots to an editable App Store Connect version"
  lane :sync_app_store_screenshots do |options|
    upload_to_app_store(
      api_key: app_store_connect_api_key_from_env,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version(options),
      screenshots_path: app_store_screenshots_path(options),
      platform: "osx",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      sync_screenshots: true,
      overwrite_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      edit_live: false,
      use_live_version: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
end

def ensure_time_sensitive_notifications_capability!
  bundle_id = Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
  UI.user_error!("Could not find Apple Developer bundle ID #{APP_IDENTIFIER}") unless bundle_id

  enabled = bundle_id.get_capabilities.any? do |capability|
    capability.capability_type == TIME_SENSITIVE_NOTIFICATIONS_CAPABILITY
  end
  return if enabled

  body = {
    data: {
      type: "bundleIds",
      id: bundle_id.id,
      attributes: {
        permissions: { edit: true, delete: true },
        seedId: bundle_id.seed_id,
        teamId: APPLE_TEAM_ID
      },
      relationships: {
        bundleIdCapabilities: {
          data: [
            {
              type: "bundleIdCapabilities",
              attributes: { enabled: true, settings: [] },
              relationships: {
                capability: {
                  data: {
                    type: "capabilities",
                    id: TIME_SENSITIVE_NOTIFICATIONS_CAPABILITY
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
  Spaceship::ConnectAPI.client.provisioning_request_client.patch(
    "v1/bundleIds/#{bundle_id.id}",
    body
  )
end

def apply_app_store_release_policy!(version)
  release_type = Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL
  version.update(attributes: { releaseType: release_type })
  version.app_store_version_phased_release&.delete!

  verified_version = Spaceship::ConnectAPI::AppStoreVersion.get(
    app_store_version_id: version.id,
    includes: "appStoreVersionPhasedRelease"
  )
  UI.user_error!("App Store version #{version.version_string} is not set for automatic release") unless verified_version.release_type == release_type
  UI.user_error!("App Store version #{version.version_string} still has a phased release") if verified_version.app_store_version_phased_release
end

def update_app_review_notes!(version)
  notes_path = File.join(REPO_ROOT, "../../app-store/review-notes.txt")
  notes = File.read(notes_path).strip
  UI.user_error!("App Review notes must not be empty") if notes == ""
  UI.user_error!("App Review notes exceed Apple's 4,000-byte limit") if notes.bytesize > 4_000

  detail = version.fetch_app_store_review_detail
  if detail
    detail.update(attributes: { notes: notes })
  else
    version.create_app_store_review_detail(attributes: { notes: notes })
  end
end

def app_store_connect_api_key_from_env
  api_key_path = File.join(fastlane_work_dir, "AuthKey.p8")
  write_base64_env_file("APP_STORE_CONNECT_API_KEY_BASE64", api_key_path)

  issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"].to_s.strip
  api_key_options = {
    key_id: required_env("APP_STORE_CONNECT_API_KEY_ID"),
    key_filepath: api_key_path,
    duration: 1200,
    in_house: false
  }
  api_key_options[:issuer_id] = issuer_id unless issuer_id == ""

  app_store_connect_api_key(**api_key_options)
end

def prepare_signing_assets
  profile_path = ENV["MAC_APP_STORE_PROVISIONING_PROFILE_PATH"]
  profile_path = File.expand_path(profile_path, REPO_ROOT) if profile_path.to_s.strip != ""
  if ENV["MAC_APP_STORE_PROVISIONING_PROFILE_BASE64"].to_s.strip != ""
    profile_path = File.join(fastlane_work_dir, "Luxel_AppStore.mobileprovision")
    write_base64_env_file("MAC_APP_STORE_PROVISIONING_PROFILE_BASE64", profile_path)
  end

  UI.user_error!("Missing MAC_APP_STORE_PROVISIONING_PROFILE_BASE64 or MAC_APP_STORE_PROVISIONING_PROFILE_PATH") if profile_path.to_s.strip == ""

  if ENV["MAC_APP_DISTRIBUTION_CERTIFICATE_BASE64"].to_s.strip != "" ||
     ENV["MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_BASE64"].to_s.strip != ""
    import_signing_certificates
  end

  {
    profile_path: profile_path,
    app_identity: ENV["APP_STORE_SIGN_IDENTITY"],
    installer_identity: ENV["INSTALLER_SIGN_IDENTITY"]
  }
end

def import_signing_certificates
  keychain_name = "luxel-ci-#{SecureRandom.hex(6)}"
  keychain_password = ENV["CI_KEYCHAIN_PASSWORD"].to_s.strip
  keychain_password = SecureRandom.hex(24) if keychain_password == ""

  create_keychain(
    name: keychain_name,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: true
  )

  app_cert_path = File.join(fastlane_work_dir, "mac_app_distribution.p12")
  installer_cert_path = File.join(fastlane_work_dir, "mac_installer_distribution.p12")

  write_base64_env_file("MAC_APP_DISTRIBUTION_CERTIFICATE_BASE64", app_cert_path)
  write_base64_env_file("MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_BASE64", installer_cert_path)

  import_certificate(
    certificate_path: app_cert_path,
    certificate_password: ENV.fetch("MAC_APP_DISTRIBUTION_CERTIFICATE_PASSWORD", ""),
    certificate_format: "pkcs12",
    keychain_name: keychain_name,
    keychain_password: keychain_password
  )
  import_certificate(
    certificate_path: installer_cert_path,
    certificate_password: ENV.fetch("MAC_INSTALLER_DISTRIBUTION_CERTIFICATE_PASSWORD", ""),
    certificate_format: "pkcs12",
    keychain_name: keychain_name,
    keychain_password: keychain_password
  )

  unless system("security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:", "-s", "-k", keychain_password, keychain_name)
    UI.user_error!("Failed to unlock imported signing identities for codesign/productbuild")
  end
end

def build_testflight_package(options, signing_assets)
  env = {
    "BUILD_NUMBER" => build_number(options),
    "PROVISIONING_PROFILE" => signing_assets.fetch(:profile_path)
  }

  marketing_version = options[:marketing_version] || ENV["MARKETING_VERSION"]
  env["MARKETING_VERSION"] = marketing_version if marketing_version.to_s.strip != ""
  env["APP_STORE_SIGN_IDENTITY"] = signing_assets.fetch(:app_identity) if signing_assets.fetch(:app_identity).to_s.strip != ""
  env["INSTALLER_SIGN_IDENTITY"] = signing_assets.fetch(:installer_identity) if signing_assets.fetch(:installer_identity).to_s.strip != ""

  script_path = File.join(REPO_ROOT, "Scripts/build-luxel-mas-pkg.sh")
  command = env.map { |key, value| "#{key}=#{Shellwords.escape(value.to_s)}" }.join(" ")
  sh("#{command} #{Shellwords.escape(script_path)}")

  pkg_path = ENV.fetch("PKG_PATH", PACKAGE_PATH)
  UI.user_error!("Expected package at #{pkg_path}") unless File.file?(pkg_path)

  pkg_path
end

def build_number(options)
  explicit_build_number = options[:build_number] || ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"]
  return explicit_build_number.to_s if explicit_build_number.to_s.strip != ""

  Time.now.utc.strftime("%Y%m%d%H%M")
end

def testflight_changelog(options)
  changelog = options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"]
  return nil if changelog.to_s.strip == ""

  changelog
end

def app_store_version(options)
  version = options[:app_version] || ENV["APP_STORE_VERSION"]
  version = version.to_s.strip
  UI.user_error!("Missing app_version or APP_STORE_VERSION") if version == ""
  UI.user_error!("App Store version must match <major>.<minor>[.<patch>]") unless version.match?(/\A\d+\.\d+(?:\.\d+)?\z/)

  version
end

def app_store_build_number(options)
  build_number = options[:build_number] || ENV["APP_STORE_BUILD_NUMBER"]
  build_number = build_number.to_s.strip
  UI.user_error!("Missing build_number or APP_STORE_BUILD_NUMBER") if build_number == ""
  UI.user_error!("App Store build number must contain only digits") unless build_number.match?(/\A\d+\z/)

  build_number
end

def app_store_metadata_path(options)
  path = options[:metadata_path] || ENV["APP_STORE_METADATA_PATH"]
  UI.user_error!("Missing metadata_path or APP_STORE_METADATA_PATH") if path.to_s.strip == ""

  path = File.expand_path(path, REPO_ROOT)
  UI.user_error!("Expected generated metadata directory at #{path}") unless Dir.exist?(path)

  path
end

def app_store_screenshots_path(options)
  path = options[:screenshots_path] || ENV["APP_STORE_SCREENSHOTS_PATH"]
  UI.user_error!("Missing screenshots_path or APP_STORE_SCREENSHOTS_PATH") if path.to_s.strip == ""

  path = File.expand_path(path, REPO_ROOT)
  UI.user_error!("Expected generated screenshots directory at #{path}") unless Dir.exist?(path)

  path
end

def fastlane_work_dir
  path = File.join(REPO_ROOT, ".build/fastlane")
  FileUtils.mkdir_p(path)
  path
end

def write_base64_env_file(env_name, path)
  value = required_env(env_name)
  File.binwrite(path, Base64.decode64(value))
  path
end

def required_env(env_name)
  value = ENV[env_name].to_s
  UI.user_error!("Missing required environment variable #{env_name}") if value.strip == ""

  value
end

            tensor<fp16, [1, 16, 1, 1]> model_f_branch_conv_f_1_layers_0_weight_to_fp16 = const()[name = string("model_f_branch_conv_f_1_layers_0_weight_to_fp16"), val = tensor<fp16, [1, 16, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(12938176)))];
            tensor<fp16, [1]> model_f_branch_conv_f_1_layers_0_bias_to_fp16 = const()[name = string("model_f_branch_conv_f_1_layers_0_bias_to_fp16"), val = tensor<fp16, [1]>([-0x1.34cp-4])];
            tensor<fp16, [1, 1, 512, 512]> f_cast_fp16 = conv(bias = model_f_branch_conv_f_1_layers_0_bias_to_fp16, dilations = f_dilations_0, groups = f_groups_0, pad = f_pad_0, pad_type = f_pad_type_0, strides = f_strides_0, weight = model_f_branch_conv_f_1_layers_0_weight_to_fp16, x = input_cast_fp16)[name = string("f_cast_fp16")];
            tensor<fp16, [1, 1, 512, 512]> matte_cast_fp16 = sigmoid(x = f_cast_fp16)[name = string("matte_cast_fp16")];
            fp16 var_2697_to_fp16 = const()[name = string("op_2697_to_fp16"), val = fp16(0x0p+0)];
            fp16 var_2698_to_fp16 = const()[name = string("op_2698_to_fp16"), val = fp16(0x1p+0)];
            tensor<fp16, [1, 1, 512, 512]> alphaMatte = clip(alpha = var_2697_to_fp16, beta = var_2698_to_fp16, x = matte_cast_fp16)[name = string("clip_0_cast_fp16")];
        } -> (alphaMatte);
}
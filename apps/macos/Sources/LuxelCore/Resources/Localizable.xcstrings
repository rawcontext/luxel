    "Opens a menu of removed transcript ranges that can be restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Opens a menu of removed transcript ranges that can be restored." } },
        "de": { "stringUnit": { "state": "translated", "value": "Öffnet ein Menü mit entfernten Transkriptbereichen, die wiederhergestellt werden können." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre un menú de intervalos eliminados de la transcripción que se pueden restaurar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre un menu des passages supprimés de la transcription qui peuvent être restaurés." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apre un menu degli intervalli rimossi dalla trascrizione che possono essere ripristinati." } },
        "ja": { "stringUnit": { "state": "translated", "value": "復元可能な削除済み文字起こし範囲のメニューを開きます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "복원할 수 있는 제거된 트랜스크립트 구간 메뉴를 엽니다." } },

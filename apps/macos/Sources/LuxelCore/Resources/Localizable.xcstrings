    "permissions.microphone.grant.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access to add your voice to recordings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Mikrofonzugriff, um deine Stimme zu Aufnahmen hinzuzufügen."
          }
        },
        "es": {

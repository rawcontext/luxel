    "studioVoice.error.bundledModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio Voice is missing or damaged. Reinstall or update Luxel, then retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio Voice fehlt oder ist beschädigt. Installiere oder aktualisiere Luxel und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz de estudio falta o está dañada. Reinstala o actualiza Luxel y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix studio est absente ou endommagée. Réinstallez ou mettez à jour Luxel, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce studio è mancante o danneggiata. Reinstalla o aggiorna Luxel, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタジオボイスが見つからないか破損しています。Luxelを再インストールまたはアップデートしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스튜디오 음성이 없거나 손상되었습니다. Luxel을 다시 설치하거나 업데이트한 후 다시 시도하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng phòng thu bị thiếu hoặc hỏng. Hãy cài đặt lại hoặc cập nhật Luxel rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音室人声缺失或已损坏。请重新安装或更新 Luxel，然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voz de estúdio está ausente ou danificada. Reinstale ou atualize o Luxel e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Voz de estúdio está em falta ou danificada. Reinstale ou atualize o Luxel e tente novamente."
          }
        }
      }
    },

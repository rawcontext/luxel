    "settings.notifications.allow": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Notifications"}},"de":{"stringUnit":{"state":"translated","value":"Benachrichtigungen erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir notificaciones"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les notifications"}},"it":{"stringUnit":{"state":"translated","value":"Consenti notifiche"}},"ja":{"stringUnit":{"state":"translated","value":"通知を許可"}},"ko":{"stringUnit":{"state":"translated","value":"알림 허용"}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép thông báo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许通知"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permitir notificações"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Permitir notificações"}}}},
    "settings.notifications.allowHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Luxel to deliver speech prompts and export completion alerts."}},"de":{"stringUnit":{"state":"translated","value":"Erlaube Luxel, Sprachhinweise und Benachrichtigungen über abgeschlossene Exporte zu senden."}},"es":{"stringUnit":{"state":"translated","value":"Permite que Luxel envíe avisos de voz y alertas al completar exportaciones."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez Luxel à envoyer des invites vocales et des alertes de fin d’exportation."}},"it":{"stringUnit":{"state":"translated","value":"Consenti a Luxel di inviare avvisi vocali e notifiche al termine delle esportazioni."}},"ja":{"stringUnit":{"state":"translated","value":"音声検出の通知と書き出し完了の通知を Luxel に許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 음성 알림과 내보내기 완료 알림을 보낼 수 있도록 허용합니다."}},"vi":{"stringUnit":{"state":"translated","value":"Cho phép Luxel gửi lời nhắc giọng nói và cảnh báo khi xuất xong."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许 Luxel 发送语音提示和导出完成提醒。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Permita que o Luxel envie avisos de fala e alertas de exportação concluída."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Permita que o Luxel envie avisos de fala e alertas de exportação concluída."}}}},
    "settings.notifications.permissionRequired": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications are off in macOS. Turn them on to receive speech prompts."}},"de":{"stringUnit":{"state":"translated","value":"Benachrichtigungen sind in macOS deaktiviert. Aktiviere sie, um Sprachhinweise zu erhalten."}},"es":{"stringUnit":{"state":"translated","value":"Las notificaciones están desactivadas en macOS. Actívalas para recibir avisos de voz."}},"fr":{"stringUnit":{"state":"translated","value":"Les notifications sont désactivées dans macOS. Activez-les pour recevoir les invites vocales."}},"it":{"stringUnit":{"state":"translated","value":"Le notifiche sono disattivate in macOS. Attivale per ricevere gli avvisi vocali."}},"ja":{"stringUnit":{"state":"translated","value":"macOS で通知がオフになっています。音声検出の通知を受け取るにはオンにしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"macOS에서 알림이 꺼져 있습니다. 음성 알림을 받으려면 켜세요."}},"vi":{"stringUnit":{"state":"translated","value":"Thông báo đang tắt trong macOS. Hãy bật để nhận lời nhắc giọng nói."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"macOS 中的通知已关闭。请将其打开以接收语音提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As notificações estão desativadas no macOS. Ative-as para receber avisos de fala."}},"pt-PT":{"stringUnit":{"state":"translated","value":"As notificações estão desativadas no macOS. Ative-as para receber avisos de fala."}}}},
    "settings.notifications.timeSensitiveRequired": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Time Sensitive notifications in macOS so speech prompts can bypass summaries and Focus."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere zeitkritische Benachrichtigungen in macOS, damit Sprachhinweise Zusammenfassungen und Fokus umgehen können."}},"es":{"stringUnit":{"state":"translated","value":"Activa las notificaciones urgentes en macOS para que los avisos de voz puedan omitir los resúmenes y los modos de concentración."}},"fr":{"stringUnit":{"state":"translated","value":"Activez les notifications urgentes dans macOS pour que les invites vocales puissent contourner les résumés et les modes Concentration."}},"it":{"stringUnit":{"state":"translated","value":"Attiva le notifiche urgenti in macOS affinché gli avvisi vocali possano superare i riepiloghi e Full immersion."}},"ja":{"stringUnit":{"state":"translated","value":"音声検出の通知が通知要約や集中モードを通過できるように、macOS で「即時通知」をオンにしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 알림이 요약 및 집중 모드를 우회할 수 있도록 macOS에서 시간 지정 알림을 켜세요."}},"vi":{"stringUnit":{"state":"translated","value":"Bật thông báo Nhạy cảm về thời gian trong macOS để lời nhắc giọng nói có thể vượt qua phần tóm tắt và chế độ Tập trung."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 macOS 中启用时效性通知，以便语音提示可以绕过通知摘要和专注模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative as notificações Sensíveis ao Tempo no macOS para que os avisos de fala possam ignorar resumos e modos Foco."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ative as notificações urgentes no macOS para que os avisos de fala possam ignorar resumos e modos de concentração."}}}},
    "settings.notifications.timeSensitiveActive": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Speech prompts are Time Sensitive and can bypass summaries and Focus when macOS allows it."}},"de":{"stringUnit":{"state":"translated","value":"Sprachhinweise sind zeitkritisch und können Zusammenfassungen und Fokus umgehen, wenn macOS dies erlaubt."}},"es":{"stringUnit":{"state":"translated","value":"Los avisos de voz son urgentes y pueden omitir los resúmenes y los modos de concentración si macOS lo permite."}},"fr":{"stringUnit":{"state":"translated","value":"Les invites vocales sont urgentes et peuvent contourner les résumés et les modes Concentration si macOS l’autorise."}},"it":{"stringUnit":{"state":"translated","value":"Gli avvisi vocali sono urgenti e possono superare i riepiloghi e Full immersion se macOS lo consente."}},"ja":{"stringUnit":{"state":"translated","value":"音声検出の通知は即時通知として配信され、macOS で許可されている場合は通知要約や集中モードを通過できます。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 알림은 시간 지정 알림이며 macOS에서 허용하면 요약 및 집중 모드를 우회할 수 있습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Lời nhắc giọng nói là thông báo Nhạy cảm về thời gian và có thể vượt qua phần tóm tắt và chế độ Tập trung khi macOS cho phép."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音提示属于时效性通知；当 macOS 允许时，它们可以绕过通知摘要和专注模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os avisos de fala são Sensíveis ao Tempo e podem ignorar resumos e modos Foco quando permitido pelo macOS."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Os avisos de fala são urgentes e podem ignorar resumos e modos de concentração quando o macOS permitir."}}}},
    "settings.notifications.system.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"System Notifications"}},"de":{"stringUnit":{"state":"translated","value":"Systembenachrichtigungen"}},"es":{"stringUnit":{"state":"translated","value":"Notificaciones del sistema"}},"fr":{"stringUnit":{"state":"translated","value":"Notifications système"}},"it":{"stringUnit":{"state":"translated","value":"Notifiche di sistema"}},"ja":{"stringUnit":{"state":"translated","value":"システム通知"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 알림"}},"vi":{"stringUnit":{"state":"translated","value":"Thông báo hệ thống"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统通知"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Notificações do sistema"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Notificações do sistema"}}}},
    "settings.notifications.timeSensitive": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Time Sensitive Speech Alerts"}},"de":{"stringUnit":{"state":"translated","value":"Zeitkritische Sprachhinweise"}},"es":{"stringUnit":{"state":"translated","value":"Avisos de voz urgentes"}},"fr":{"stringUnit":{"state":"translated","value":"Alertes vocales urgentes"}},"it":{"stringUnit":{"state":"translated","value":"Avvisi vocali urgenti"}},"ja":{"stringUnit":{"state":"translated","value":"音声検出の即時通知"}},"ko":{"stringUnit":{"state":"translated","value":"시간 지정 음성 알림"}},"vi":{"stringUnit":{"state":"translated","value":"Cảnh báo giọng nói nhạy cảm về thời gian"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时效性语音提醒"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Alertas de fala sensíveis ao tempo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Alertas de fala urgentes"}}}},
    "settings.notifications.timeSensitiveHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open macOS settings for Time Sensitive speech alerts."}},"de":{"stringUnit":{"state":"translated","value":"Öffne die macOS-Einstellungen für zeitkritische Sprachhinweise."}},"es":{"stringUnit":{"state":"translated","value":"Abre los ajustes de macOS para los avisos de voz urgentes."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez les réglages macOS des alertes vocales urgentes."}},"it":{"stringUnit":{"state":"translated","value":"Apri le impostazioni di macOS per gli avvisi vocali urgenti."}},"ja":{"stringUnit":{"state":"translated","value":"音声検出の即時通知に関する macOS 設定を開きます。"}},"ko":{"stringUnit":{"state":"translated","value":"시간 지정 음성 알림의 macOS 설정을 엽니다."}},"vi":{"stringUnit":{"state":"translated","value":"Mở cài đặt macOS cho cảnh báo giọng nói nhạy cảm về thời gian."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 macOS 中时效性语音提醒的设置。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra os ajustes do macOS para alertas de fala sensíveis ao tempo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Abra as definições do macOS para alertas de fala urgentes."}}}},
    "settings.notifications.types.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Notification Types"}},"de":{"stringUnit":{"state":"translated","value":"Benachrichtigungstypen"}},"es":{"stringUnit":{"state":"translated","value":"Tipos de notificación"}},"fr":{"stringUnit":{"state":"translated","value":"Types de notifications"}},"it":{"stringUnit":{"state":"translated","value":"Tipi di notifica"}},"ja":{"stringUnit":{"state":"translated","value":"通知の種類"}},"ko":{"stringUnit":{"state":"translated","value":"알림 유형"}},"vi":{"stringUnit":{"state":"translated","value":"Các loại thông báo"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知类型"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tipos de notificação"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Tipos de notificação"}}}},
    "settings.notifications.speechDetection": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Speech Detection Prompts"}},"de":{"stringUnit":{"state":"translated","value":"Spracherkennungshinweise"}},"es":{"stringUnit":{"state":"translated","value":"Avisos de detección de voz"}},"fr":{"stringUnit":{"state":"translated","value":"Invites de détection de parole"}},"it":{"stringUnit":{"state":"translated","value":"Avvisi di rilevamento vocale"}},"ja":{"stringUnit":{"state":"translated","value":"音声検出の通知"}},"ko":{"stringUnit":{"state":"translated","value":"음성 감지 알림"}},"vi":{"stringUnit":{"state":"translated","value":"Lời nhắc phát hiện giọng nói"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音检测提示"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avisos de detecção de fala"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Avisos de deteção de fala"}}}},
    "settings.notifications.speechDetectionHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Notify you after Luxel detects sustained speech."}},"de":{"stringUnit":{"state":"translated","value":"Benachrichtigt dich, wenn Luxel anhaltende Sprache erkennt."}},"es":{"stringUnit":{"state":"translated","value":"Te avisa cuando Luxel detecta voz continua."}},"fr":{"stringUnit":{"state":"translated","value":"Vous avertit lorsque Luxel détecte une parole continue."}},"it":{"stringUnit":{"state":"translated","value":"Avvisa quando Luxel rileva voce continua."}},"ja":{"stringUnit":{"state":"translated","value":"Luxel が継続的な音声を検出したときに通知します。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 지속적인 음성을 감지하면 알려 줍니다."}},"vi":{"stringUnit":{"state":"translated","value":"Thông báo khi Luxel phát hiện giọng nói liên tục."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 检测到持续语音时通知你。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avisa quando o Luxel detecta fala contínua."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Avisa quando o Luxel deteta fala contínua."}}}},
    "settings.notifications.exportComplete": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Export Completed"}},"de":{"stringUnit":{"state":"translated","value":"Export abgeschlossen"}},"es":{"stringUnit":{"state":"translated","value":"Exportación completada"}},"fr":{"stringUnit":{"state":"translated","value":"Exportation terminée"}},"it":{"stringUnit":{"state":"translated","value":"Esportazione completata"}},"ja":{"stringUnit":{"state":"translated","value":"書き出し完了"}},"ko":{"stringUnit":{"state":"translated","value":"내보내기 완료"}},"vi":{"stringUnit":{"state":"translated","value":"Xuất hoàn tất"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出完成"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Exportação concluída"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Exportação concluída"}}}},
    "settings.notifications.exportCompleteHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Notify you when an editor export finishes."}},"de":{"stringUnit":{"state":"translated","value":"Benachrichtigt dich, wenn ein Export im Editor abgeschlossen ist."}},"es":{"stringUnit":{"state":"translated","value":"Te avisa cuando finaliza una exportación del editor."}},"fr":{"stringUnit":{"state":"translated","value":"Vous avertit lorsqu’une exportation de l’éditeur est terminée."}},"it":{"stringUnit":{"state":"translated","value":"Avvisa al termine di un’esportazione dall’editor."}},"ja":{"stringUnit":{"state":"translated","value":"エディタでの書き出しが完了したときに通知します。"}},"ko":{"stringUnit":{"state":"translated","value":"편집기 내보내기가 완료되면 알려 줍니다."}},"vi":{"stringUnit":{"state":"translated","value":"Thông báo khi quá trình xuất trong trình chỉnh sửa hoàn tất."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑器导出完成时通知你。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avisa quando uma exportação do editor termina."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Avisa quando uma exportação do editor termina."}}}},
    "settings.speechDetection.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Speech Detection"}},"de":{"stringUnit":{"state":"translated","value":"Spracherkennung"}},"es":{"stringUnit":{"state":"translated","value":"Detección de voz"}},"fr":{"stringUnit":{"state":"translated","value":"Détection de parole"}},"it":{"stringUnit":{"state":"translated","value":"Rilevamento vocale"}},"ja":{"stringUnit":{"state":"translated","value":"音声検出"}},"ko":{"stringUnit":{"state":"translated","value":"음성 감지"}},"vi":{"stringUnit":{"state":"translated","value":"Phát hiện giọng nói"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音检测"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Detecção de fala"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Deteção de fala"}}}},
    "settings.speechDetection.toggle": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Notify When Speech Is Detected"}},"de":{"stringUnit":{"state":"translated","value":"Bei erkannter Sprache benachrichtigen"}},"es":{"stringUnit":{"state":"translated","value":"Notificar al detectar voz"}},"fr":{"stringUnit":{"state":"translated","value":"Notifier quand de la parole est détectée"}},"it":{"stringUnit":{"state":"translated","value":"Avvisa quando viene rilevata la voce"}},"ja":{"stringUnit":{"state":"translated","value":"音声を検出したときに通知"}},"ko":{"stringUnit":{"state":"translated","value":"음성이 감지되면 알림"}},"vi":{"stringUnit":{"state":"translated","value":"Thông báo khi phát hiện giọng nói"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到语音时通知"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Notificar ao detectar fala"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Notificar ao detetar fala"}}}},
    "settings.speechDetection.help": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show a recording prompt after Luxel detects sustained speech on the selected microphone."}},"de":{"stringUnit":{"state":"translated","value":"Zeige eine Aufnahmeaufforderung, nachdem Luxel anhaltende Sprache am ausgewählten Mikrofon erkennt."}},"es":{"stringUnit":{"state":"translated","value":"Muestra un aviso de grabación cuando Luxel detecte voz continua en el micrófono seleccionado."}},"fr":{"stringUnit":{"state":"translated","value":"Affichez une invite d’enregistrement lorsque Luxel détecte une parole continue sur le microphone sélectionné."}},"it":{"stringUnit":{"state":"translated","value":"Mostra una richiesta di registrazione quando Luxel rileva voce continua sul microfono selezionato."}},"ja":{"stringUnit":{"state":"translated","value":"選択したマイクで継続的な音声を検出した後に、録音を促す通知を表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 마이크에서 지속적인 음성이 감지되면 녹음 알림을 표시합니다."}},"vi":{"stringUnit":{"state":"translated","value":"Hiển thị lời nhắc ghi âm sau khi Luxel phát hiện giọng nói liên tục trên micrô đã chọn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 在所选麦克风上检测到持续语音后显示录制提示。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mostra um aviso de gravação quando o Luxel detecta fala contínua no microfone selecionado."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Mostra um aviso de gravação quando o Luxel deteta fala contínua no microfone selecionado."}}}},
    "settings.speechDetection.footer": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel analyzes microphone audio on this Mac while it is running. Audio is discarded unless you start recording."}},"de":{"stringUnit":{"state":"translated","value":"Luxel analysiert während der Ausführung Mikrofon-Audio auf diesem Mac. Audio wird verworfen, sofern du keine Aufnahme startest."}},"es":{"stringUnit":{"state":"translated","value":"Luxel analiza el audio del micrófono en este Mac mientras está abierto. El audio se descarta salvo que inicies una grabación."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel analyse le son du microphone sur ce Mac pendant son fonctionnement. Le son est supprimé sauf si vous démarrez un enregistrement."}},"it":{"stringUnit":{"state":"translated","value":"Luxel analizza l’audio del microfono su questo Mac mentre è in esecuzione. L’audio viene eliminato a meno che non avvii una registrazione."}},"ja":{"stringUnit":{"state":"translated","value":"Luxel の実行中は、この Mac 上でマイク音声を解析します。録音を開始しない限り、音声は破棄されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 실행되는 동안 이 Mac에서 마이크 오디오를 분석합니다. 녹음을 시작하지 않으면 오디오는 폐기됩니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel phân tích âm thanh micrô trên máy Mac này khi đang chạy. Âm thanh sẽ bị loại bỏ trừ khi bạn bắt đầu ghi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 运行时会在这台 Mac 上分析麦克风音频。除非你开始录制，否则音频会被丢弃。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel analisa o áudio do microfone neste Mac enquanto está em execução. O áudio é descartado, a menos que você inicie uma gravação."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel analisa o áudio do microfone neste Mac enquanto está em execução. O áudio é eliminado, a menos que inicie uma gravação."}}}},
    "settings.speechDetection.launchAtLoginFooter": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Works while Luxel is open. Turn on Launch at Login to make it available after you sign in."}},"de":{"stringUnit":{"state":"translated","value":"Funktioniert, solange Luxel geöffnet ist. Aktiviere „Beim Anmelden öffnen“, damit die Funktion nach der Anmeldung verfügbar ist."}},"es":{"stringUnit":{"state":"translated","value":"Funciona mientras Luxel está abierto. Activa Abrir al iniciar sesión para que esté disponible al entrar."}},"fr":{"stringUnit":{"state":"translated","value":"Fonctionne lorsque Luxel est ouvert. Activez Ouvrir à la connexion pour que cette fonction soit disponible après votre connexion."}},"it":{"stringUnit":{"state":"translated","value":"Funziona mentre Luxel è aperto. Attiva Apri al login per renderlo disponibile dopo l’accesso."}},"ja":{"stringUnit":{"state":"translated","value":"Luxel が開いている間に機能します。サインイン後も利用するには「ログイン時に開く」をオンにしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 열려 있는 동안 작동합니다. 로그인 후에도 사용하려면 로그인 시 열기를 켜세요."}},"vi":{"stringUnit":{"state":"translated","value":"Hoạt động khi Luxel đang mở. Bật Mở khi đăng nhập để sử dụng sau khi bạn đăng nhập."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Luxel 打开时有效。打开“登录时启动”，即可在登录后使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Funciona enquanto o Luxel está aberto. Ative Abrir ao Iniciar para disponibilizar após iniciar a sessão."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Funciona enquanto o Luxel está aberto. Ative Abrir ao iniciar sessão para ficar disponível após iniciar sessão."}}}},
    "settings.speechDetection.disclosure.title": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Speech Detection Prompts?"}},"de":{"stringUnit":{"state":"translated","value":"Hinweise zur Spracherkennung aktivieren?"}},"es":{"stringUnit":{"state":"translated","value":"¿Activar los avisos de detección de voz?"}},"fr":{"stringUnit":{"state":"translated","value":"Activer les invites de détection de parole ?"}},"it":{"stringUnit":{"state":"translated","value":"Abilitare gli avvisi di rilevamento vocale?"}},"ja":{"stringUnit":{"state":"translated","value":"音声検出通知を有効にしますか？"}},"ko":{"stringUnit":{"state":"translated","value":"음성 감지 알림을 활성화할까요?"}},"vi":{"stringUnit":{"state":"translated","value":"Bật lời nhắc phát hiện giọng nói?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用语音检测提示？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar avisos de detecção de fala?"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ativar avisos de deteção de fala?"}}}},
    "settings.speechDetection.disclosure.enable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable"}},"de":{"stringUnit":{"state":"translated","value":"Aktivieren"}},"es":{"stringUnit":{"state":"translated","value":"Activar"}},"fr":{"stringUnit":{"state":"translated","value":"Activer"}},"it":{"stringUnit":{"state":"translated","value":"Abilita"}},"ja":{"stringUnit":{"state":"translated","value":"有効にする"}},"ko":{"stringUnit":{"state":"translated","value":"활성화"}},"vi":{"stringUnit":{"state":"translated","value":"Bật"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativar"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ativar"}}}},
    "settings.speechDetection.disclosure.cancel": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel"}},"de":{"stringUnit":{"state":"translated","value":"Abbrechen"}},"es":{"stringUnit":{"state":"translated","value":"Cancelar"}},"fr":{"stringUnit":{"state":"translated","value":"Annuler"}},"it":{"stringUnit":{"state":"translated","value":"Annulla"}},"ja":{"stringUnit":{"state":"translated","value":"キャンセル"}},"ko":{"stringUnit":{"state":"translated","value":"취소"}},"vi":{"stringUnit":{"state":"translated","value":"Hủy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cancelar"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Cancelar"}}}},
    "settings.speechDetection.disclosure.body": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel will listen to the selected microphone while it is running and notify you after it detects sustained speech. Detection happens on this Mac, and audio is not saved unless you start recording."}},"de":{"stringUnit":{"state":"translated","value":"Luxel hört während der Ausführung das ausgewählte Mikrofon ab und benachrichtigt dich, wenn anhaltende Sprache erkannt wird. Die Erkennung erfolgt auf diesem Mac, und Audio wird nur gespeichert, wenn du eine Aufnahme startest."}},"es":{"stringUnit":{"state":"translated","value":"Luxel escuchará el micrófono seleccionado mientras esté abierto y te avisará cuando detecte voz continua. La detección se realiza en este Mac y el audio no se guarda salvo que inicies una grabación."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel écoutera le microphone sélectionné pendant son fonctionnement et vous avertira après avoir détecté une parole continue. La détection s’effectue sur ce Mac et le son n’est enregistré que si vous démarrez un enregistrement."}},"it":{"stringUnit":{"state":"translated","value":"Luxel ascolterà il microfono selezionato mentre è in esecuzione e ti avviserà quando rileva voce continua. Il rilevamento avviene su questo Mac e l’audio non viene salvato a meno che non avvii una registrazione."}},"ja":{"stringUnit":{"state":"translated","value":"Luxel の実行中は選択したマイクを監視し、継続的な音声を検出すると通知します。検出はこの Mac 上で行われ、録音を開始しない限り音声は保存されません。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 실행되는 동안 선택한 마이크를 듣고 지속적인 음성이 감지되면 알려 줍니다. 감지는 이 Mac에서 수행되며 녹음을 시작하지 않으면 오디오는 저장되지 않습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel sẽ lắng nghe micrô đã chọn khi đang chạy và thông báo sau khi phát hiện giọng nói liên tục. Việc phát hiện diễn ra trên máy Mac này và âm thanh không được lưu trừ khi bạn bắt đầu ghi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 运行时会监听所选麦克风，并在检测到持续语音后通知你。检测在这台 Mac 上进行，除非你开始录制，否则不会保存音频。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel ouvirá o microfone selecionado enquanto estiver em execução e avisará após detectar fala contínua. A detecção acontece neste Mac e o áudio não é salvo, a menos que você inicie uma gravação."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel ouvirá o microfone selecionado enquanto estiver em execução e avisará após detetar fala contínua. A deteção acontece neste Mac e o áudio não é guardado, a menos que inicie uma gravação."}}}},
    "settings.speechDetection.microphoneHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the microphone Luxel records or analyzes for speech detection."}},"de":{"stringUnit":{"state":"translated","value":"Wähle das Mikrofon, das Luxel aufnimmt oder für die Spracherkennung analysiert."}},"es":{"stringUnit":{"state":"translated","value":"Elige el micrófono que Luxel graba o analiza para detectar voz."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le microphone que Luxel enregistre ou analyse pour détecter la parole."}},"it":{"stringUnit":{"state":"translated","value":"Scegli il microfono che Luxel registra o analizza per il rilevamento vocale."}},"ja":{"stringUnit":{"state":"translated","value":"Luxel が録音または音声検出のために解析するマイクを選択します。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 녹음하거나 음성 감지를 위해 분석할 마이크를 선택합니다."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn micrô mà Luxel ghi hoặc phân tích để phát hiện giọng nói."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 Luxel 用于录音或语音检测分析的麦克风。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o microfone que o Luxel grava ou analisa para detectar fala."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha o microfone que o Luxel grava ou analisa para detetar fala."}}}},

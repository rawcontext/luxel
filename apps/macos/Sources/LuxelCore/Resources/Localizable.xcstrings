    "Automatically start playback when selecting a transcript word.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatically start playback when selecting a transcript word." } },
        "de": { "stringUnit": { "state": "translated", "value": "Wiedergabe automatisch starten, wenn ein Wort im Transkript ausgewählt wird." } },
        "es": { "stringUnit": { "state": "translated", "value": "Inicia automáticamente la reproducción al seleccionar una palabra de la transcripción." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Démarre automatiquement la lecture lors de la sélection d’un mot dans la transcription." } },
        "it": { "stringUnit": { "state": "translated", "value": "Avvia automaticamente la riproduzione quando selezioni una parola della trascrizione." } },
        "ja": { "stringUnit": { "state": "translated", "value": "文字起こしの単語を選択したときに自動的に再生を開始します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "트랜스크립트에서 단어를 선택하면 자동으로 재생을 시작합니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tự động bắt đầu phát khi chọn một từ trong bản chép lời." } },

        "pt-BR": { "stringUnit": { "state": "translated", "value": "O Luxel não encontrou uma faixa de áudio para transcrever nesta gravação." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "O Luxel não encontrou uma faixa de áudio para transcrever nesta gravação." } }
      }
    },
    "transcription.error.trackIsolationFailed": {

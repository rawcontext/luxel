    "Frame rate follows the display's supported refresh rate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate follows the display's supported refresh rate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildrate folgt der unterstützten Bildwiederholrate des Displays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia de fotogramas sigue la frecuencia de actualización compatible de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fréquence d’images suit la fréquence de rafraîchissement prise en charge par l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frequenza fotogrammi segue la frequenza di aggiornamento supportata dallo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームレートは、ディスプレイが対応するリフレッシュレートに追従します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임률이 디스플레이가 지원하는 재생률을 따릅니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ khung hình sẽ theo tần số quét được màn hình hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧率将跟随显示器支持的刷新率。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa de quadros acompanha a taxa de atualização compatível com a tela."

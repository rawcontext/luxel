        "ja": { "stringUnit": { "state": "translated", "value": "%@ が Luxel を操作しようとしています。ターミナルで `luxel pair` を実行した場合のみ許可してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@에서 Luxel을 제어하려고 합니다. 터미널에서 `luxel pair`를 실행한 경우에만 허용하세요." } },
        "vi": { "stringUnit": { "state": "translated", "value": "%@ muốn điều khiển Luxel. Chỉ cho phép nếu bạn đã chạy `luxel pair` trong Terminal." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 想要控制 Luxel。仅当你在终端中运行了 `luxel pair` 时才允许。" } },

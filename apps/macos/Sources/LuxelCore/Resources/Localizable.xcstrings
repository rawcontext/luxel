            "value": "Der Wiedergabepuffer verwendet die Bildschirmaufnahmeberechtigung und bleibt während der Aktivität in der Menüleiste sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El búfer de repetición usa el permiso de grabación de pantalla y permanece visible en la barra de menús mientras está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tampon de relecture utilise l’autorisation d’enregistrement de l’écran et reste visible dans la barre des menus lorsqu’il est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il buffer di replay usa il permesso di registrazione dello schermo e resta visibile nella barra dei menu mentre è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リプレイバッファは画面収録の権限を使用し、有効な間はメニューバーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리플레이 버퍼는 화면 기록 권한을 사용하며 활성화된 동안 메뉴 막대에 표시됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ đệm phát lại dùng quyền ghi màn hình và hiển thị trên thanh menu khi hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回放缓冲区使用屏幕录制权限，并在启用时显示在菜单栏中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O buffer de replay usa a permissão de gravação de tela e fica visível na barra de menus enquanto está ativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória intermédia de repetição usa a permissão de gravação do ecrã e permanece visível na barra de menus enquanto está ativa."
          }
        }
      }
    },

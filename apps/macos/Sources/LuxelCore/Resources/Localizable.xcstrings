    "Turn this off for faster raw transcripts on long audio recordings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this off for faster raw transcripts on long audio recordings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren, um bei langen Audioaufnahmen schneller unsegmentierte Transkripte zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva esta opción para obtener transcripciones sin procesar más rápidas en grabaciones de audio largas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette option pour accélérer les transcriptions brutes des longs enregistrements audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa opzione per ottenere più rapidamente trascrizioni grezze di registrazioni audio lunghe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、長い録音の未処理の文字起こしが速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 끄면 긴 오디오 녹음의 원본 대화 내용 기록이 더 빨라집니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt tùy chọn này để có bản chép lời thô nhanh hơn cho bản ghi âm dài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项可更快生成长录音的原始转录文本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative esta opção para obter transcrições brutas mais rápidas de gravações de áudio longas."
          }
        },

    "Undo the transcript cut. You can also press Command-Z.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Undo the transcript cut. You can also press Command-Z." } },
        "de": { "stringUnit": { "state": "translated", "value": "Transkriptschnitt rückgängig machen. Alternativ Befehlstaste-Z drücken." } },
        "es": { "stringUnit": { "state": "translated", "value": "Deshaz el corte de la transcripción. También puedes pulsar Comando-Z." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Annule la coupe effectuée via la transcription. Vous pouvez aussi appuyer sur Commande-Z." } },
        "it": { "stringUnit": { "state": "translated", "value": "Annulla il taglio della trascrizione. Puoi anche premere Comando-Z." } },
        "ja": { "stringUnit": { "state": "translated", "value": "文字起こしによるカットを取り消します。Command-Z キーでも操作できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "트랜스크립트 잘라내기를 실행 취소합니다. Command-Z를 눌러도 됩니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hoàn tác đoạn cắt trong bản chép lời. Bạn cũng có thể nhấn Command-Z." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "撤销转录剪除操作。也可以按 Command-Z。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Desfaz o corte feito pela transcrição. Você também pode pressionar Command-Z." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Anula o corte feito através da transcrição. Também pode premir Command-Z." } }
      }
    },
    "Restores the words and media removed by the last transcript cut.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Restores the words and media removed by the last transcript cut." } },
        "de": { "stringUnit": { "state": "translated", "value": "Stellt die durch den letzten Transkriptschnitt entfernten Wörter und Medien wieder her." } },
        "es": { "stringUnit": { "state": "translated", "value": "Restaura las palabras y el contenido multimedia eliminados por el último corte de la transcripción." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Restaure les mots et le contenu multimédia supprimés par la dernière coupe via la transcription." } },
        "it": { "stringUnit": { "state": "translated", "value": "Ripristina le parole e i contenuti multimediali rimossi dall’ultimo taglio della trascrizione." } },
        "ja": { "stringUnit": { "state": "translated", "value": "最後の文字起こしによるカットで削除された単語とメディアを復元します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "마지막 트랜스크립트 잘라내기로 제거된 단어와 미디어를 복원합니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Khôi phục các từ và nội dung đa phương tiện bị xóa bởi lần cắt bản chép lời gần nhất." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "恢复上次转录剪除操作移除的词语和媒体内容。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Restaura as palavras e a mídia removidas pelo último corte da transcrição." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Restaura as palavras e os elementos multimédia removidos pelo último corte da transcrição." } }
      }
    },
    "Cut selected words from the recording (Delete)": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cut selected words from the recording (Delete)" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ausgewählte Wörter aus der Aufnahme herausschneiden (Löschen)" } },
        "es": { "stringUnit": { "state": "translated", "value": "Cortar las palabras seleccionadas de la grabación (Suprimir)" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Couper les mots sélectionnés de l’enregistrement (Supprimer)" } },
        "it": { "stringUnit": { "state": "translated", "value": "Taglia le parole selezionate dalla registrazione (Canc)" } },
        "ja": { "stringUnit": { "state": "translated", "value": "選択した単語を録画からカット（Delete）" } },
        "ko": { "stringUnit": { "state": "translated", "value": "선택한 단어를 녹화에서 잘라내기(Delete)" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Cắt các từ đã chọn khỏi bản ghi (Delete)" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "从录制中剪除所选词语（Delete）" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Cortar as palavras selecionadas da gravação (Delete)" } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Cortar as palavras selecionadas da gravação (Delete)" } }
      }
    },
    "Press Delete to cut the selected words. The original recording stays safe.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Press Delete to cut the selected words. The original recording stays safe." } },
        "de": { "stringUnit": { "state": "translated", "value": "Löschtaste drücken, um die ausgewählten Wörter herauszuschneiden. Die Originalaufnahme bleibt sicher." } },
        "es": { "stringUnit": { "state": "translated", "value": "Pulsa Suprimir para cortar las palabras seleccionadas. La grabación original permanece a salvo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Appuyez sur Supprimer pour couper les mots sélectionnés. L’enregistrement original reste intact." } },
        "it": { "stringUnit": { "state": "translated", "value": "Premi Canc per tagliare le parole selezionate. La registrazione originale rimane al sicuro." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Delete キーを押して選択した単語をカットします。元の録画は保持されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Delete 키를 눌러 선택한 단어를 잘라내세요. 원본 녹화는 안전하게 유지됩니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Nhấn Delete để cắt các từ đã chọn. Bản ghi gốc vẫn an toàn." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "按 Delete 键剪除所选词语。原始录制安全无损。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Pressione Delete para cortar as palavras selecionadas. A gravação original fica segura." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Prima Delete para cortar as palavras selecionadas. A gravação original permanece segura." } }
      }
    },
    "Auto-play": {
      "extractionState": "manual",
      "localizations": {

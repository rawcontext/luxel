    "permissions.systemAudio.instructions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"System sound uses macOS Screen & System Audio Recording. If Luxel is not listed, click + and add the app."}},"de":{"stringUnit":{"state":"translated","value":"Systemsound verwendet unter macOS „Bildschirm- & Systemaudioaufnahme“. Wenn Luxel nicht aufgeführt ist, klicke auf + und füge die App hinzu."}},"es":{"stringUnit":{"state":"translated","value":"El sonido del sistema usa Grabación de pantalla y audio del sistema de macOS. Si Luxel no aparece, haz clic en + y añade la app."}},"fr":{"stringUnit":{"state":"translated","value":"Le son système utilise « Enregistrement de l’écran et de l’audio système » de macOS. Si Luxel n’est pas répertorié, cliquez sur + et ajoutez l’app."}},"it":{"stringUnit":{"state":"translated","value":"L’audio di sistema usa Registrazione schermo e audio di sistema di macOS. Se Luxel non è nell’elenco, fai clic su + e aggiungi l’app."}},"ja":{"stringUnit":{"state":"translated","value":"システム音声にはmacOSの「画面収録とシステムオーディオ録音」を使用します。Luxelが一覧にない場合は、＋をクリックして追加してください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 사운드는 macOS의 화면 및 시스템 오디오 녹음을 사용합니다. Luxel이 목록에 없으면 +를 클릭하여 앱을 추가하세요."}},"vi":{"stringUnit":{"state":"translated","value":"Âm thanh hệ thống sử dụng quyền Ghi màn hình và âm thanh hệ thống của macOS. Nếu không thấy Luxel, hãy nhấp + và thêm ứng dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统声音使用 macOS 的“屏幕与系统音频录制”权限。如果列表中没有 Luxel，请点按 + 并添加该 App。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O som do sistema usa Gravação de Tela e Áudio do Sistema do macOS. Se o Luxel não estiver na lista, clique em + e adicione o app."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O som do sistema utiliza Gravação do ecrã e do áudio do sistema do macOS. Se o Luxel não estiver na lista, clique em + e adicione a aplicação."}}}},
    "The export was canceled before the output file was finished.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The export was canceled before the output file was finished."}},"de":{"stringUnit":{"state":"translated","value":"Der Export wurde abgebrochen, bevor die Ausgabedatei fertiggestellt war."}},"es":{"stringUnit":{"state":"translated","value":"La exportación se canceló antes de terminar el archivo de salida."}},"fr":{"stringUnit":{"state":"translated","value":"L’exportation a été annulée avant la fin du fichier de sortie."}},"it":{"stringUnit":{"state":"translated","value":"L’esportazione è stata annullata prima del completamento del file di uscita."}},"ja":{"stringUnit":{"state":"translated","value":"出力ファイルの完成前に書き出しがキャンセルされました。"}},"ko":{"stringUnit":{"state":"translated","value":"출력 파일이 완성되기 전에 내보내기가 취소되었습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Quá trình xuất đã bị hủy trước khi tệp đầu ra hoàn tất."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输出文件完成前，导出已被取消。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A exportação foi cancelada antes de o arquivo de saída ser concluído."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A exportação foi cancelada antes de o ficheiro de saída estar concluído."}}}},
    "The notch surface and floating HUD fallback are disabled.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The notch surface and floating HUD fallback are disabled."}},"de":{"stringUnit":{"state":"translated","value":"Die Notch-Anzeige und die schwebende Ersatzanzeige sind deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La interfaz de la muesca y el HUD flotante alternativo están desactivados."}},"fr":{"stringUnit":{"state":"translated","value":"L’affichage dans l’encoche et le panneau flottant de remplacement sont désactivés."}},"it":{"stringUnit":{"state":"translated","value":"La superficie del notch e il pannello flottante alternativo sono disattivati."}},"ja":{"stringUnit":{"state":"translated","value":"ノッチ表示と代替のフローティングHUDは無効です。"}},"ko":{"stringUnit":{"state":"translated","value":"노치 표시와 대체 플로팅 HUD가 비활성화되어 있습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Hiển thị ở phần khuyết và bảng HUD nổi thay thế đều đang tắt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刘海区域显示和浮动 HUD 备用显示均已关闭。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A interface do recorte e o HUD flutuante alternativo estão desativados."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A interface do recorte e o HUD flutuante alternativo estão desativados."}}}},
    "The notch surface is disabled, so recording controls will use the fallback surface.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The notch surface is disabled, so recording controls will use the fallback surface."}},"de":{"stringUnit":{"state":"translated","value":"Die Notch-Anzeige ist deaktiviert. Die Aufnahmesteuerung nutzt daher die Ersatzanzeige."}},"es":{"stringUnit":{"state":"translated","value":"La interfaz de la muesca está desactivada; los controles de grabación usarán la interfaz alternativa."}},"fr":{"stringUnit":{"state":"translated","value":"L’affichage dans l’encoche est désactivé ; les commandes d’enregistrement utiliseront l’affichage de remplacement."}},"it":{"stringUnit":{"state":"translated","value":"La superficie del notch è disattivata, quindi i controlli di registrazione useranno la visualizzazione alternativa."}},"ja":{"stringUnit":{"state":"translated","value":"ノッチ表示が無効なため、収録コントロールには代替表示を使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"노치 표시가 비활성화되어 있어 녹화 제어에 대체 표시를 사용합니다."}},"vi":{"stringUnit":{"state":"translated","value":"Hiển thị ở phần khuyết đang tắt nên các điều khiển ghi sẽ dùng giao diện thay thế."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刘海区域显示已关闭，录制控件将使用备用显示方式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A interface do recorte está desativada, então os controles de gravação usarão a interface alternativa."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A interface do recorte está desativada, pelo que os controlos de gravação utilizarão a interface alternativa."}}}},

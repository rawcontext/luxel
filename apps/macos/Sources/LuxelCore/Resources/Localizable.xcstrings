    "updates.networkPolicy.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic update checks are off; Luxel will not contact the update server."
          }
        },
        "de": {

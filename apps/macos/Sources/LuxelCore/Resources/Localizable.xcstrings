    "Luxel can capture key identities while an enabled recording is active.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel can capture key identities while an enabled recording is active."}},"de":{"stringUnit":{"state":"translated","value":"Luxel kann während einer Aufnahme mit aktivierter Tastenerfassung die gedrückten Tasten erfassen."}},"es":{"stringUnit":{"state":"translated","value":"Luxel puede capturar las teclas pulsadas durante una grabación con esta función activada."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel peut identifier les touches pressées pendant un enregistrement où cette fonction est activée."}},"it":{"stringUnit":{"state":"translated","value":"Luxel può rilevare i tasti premuti durante una registrazione con questa funzione attiva."}},"ja":{"stringUnit":{"state":"translated","value":"キー入力の収録が有効な収録中は、Luxelが押されたキーを記録できます。"}},"ko":{"stringUnit":{"state":"translated","value":"키 입력 캡처를 켠 상태로 녹화하는 동안 Luxel이 누른 키를 기록할 수 있습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel có thể ghi lại các phím được nhấn trong khi bản ghi có bật tính năng này đang chạy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在启用按键捕获的录制期间，Luxel 可以记录按下的键。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel pode capturar as teclas pressionadas durante uma gravação com esse recurso ativado."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel pode capturar as teclas premidas durante uma gravação com esta função ativada."}}}},
    "Luxel can record your screen and system sound.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel can record your screen and system sound."}},"de":{"stringUnit":{"state":"translated","value":"Luxel kann deinen Bildschirm und Systemsound aufnehmen."}},"es":{"stringUnit":{"state":"translated","value":"Luxel puede grabar la pantalla y el sonido del sistema."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel peut enregistrer votre écran et le son système."}},"it":{"stringUnit":{"state":"translated","value":"Luxel può registrare lo schermo e l’audio di sistema."}},"ja":{"stringUnit":{"state":"translated","value":"Luxel は画面とシステム音声を収録できます。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 화면과 시스템 오디오를 녹화할 수 있습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel có thể ghi màn hình và âm thanh hệ thống của bạn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 可以录制你的屏幕和系统声音。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel pode gravar sua tela e o som do sistema."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel pode gravar o ecrã e o som do sistema."}}}},
    "Luxel can use the built-in notch display.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel can use the built-in notch display."}},"de":{"stringUnit":{"state":"translated","value":"Luxel kann die integrierte Display-Notch nutzen."}},"es":{"stringUnit":{"state":"translated","value":"Luxel puede usar la muesca de la pantalla integrada."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel peut utiliser l’encoche de l’écran intégré."}},"it":{"stringUnit":{"state":"translated","value":"Luxel può usare il notch dello schermo integrato."}},"ja":{"stringUnit":{"state":"translated","value":"Luxelは内蔵ディスプレイのノッチを利用できます。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 내장 디스플레이의 노치를 사용할 수 있습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel có thể sử dụng phần khuyết trên màn hình tích hợp."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 可以使用内置显示器的刘海区域。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel pode usar o recorte da tela integrada."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel pode utilizar o recorte do ecrã integrado."}}}},

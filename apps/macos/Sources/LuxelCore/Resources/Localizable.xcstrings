        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập micrô để thêm giọng nói của bạn vào bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

        "vi": { "stringUnit": { "state": "translated", "value": "Chọn các từ, sau đó chọn “Cắt khỏi bản ghi” hoặc nhấn Delete." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择词语，然后选择“从录制中剪除”或按 Delete 键。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Selecione palavras e escolha “Cortar da gravação” ou pressione Delete." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Selecione palavras e escolha «Cortar da gravação» ou prima Delete." } }
      }
    },
    "Non-destructive: your original recording is safe, and cuts can be undone or restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Non-destructive: your original recording is safe, and cuts can be undone or restored." } },
        "de": { "stringUnit": { "state": "translated", "value": "Nicht destruktiv: Die Originalaufnahme bleibt sicher, und Schnitte können rückgängig gemacht oder wiederhergestellt werden." } },
        "es": { "stringUnit": { "state": "translated", "value": "No destructivo: tu grabación original está a salvo y los cortes se pueden deshacer o restaurar." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Non destructif : votre enregistrement original reste intact et les coupes peuvent être annulées ou restaurées." } },
        "it": { "stringUnit": { "state": "translated", "value": "Non distruttivo: la registrazione originale rimane al sicuro e i tagli possono essere annullati o ripristinati." } },
        "ja": { "stringUnit": { "state": "translated", "value": "非破壊編集：元の録画は保持され、カットは取り消したり復元したりできます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "비파괴 편집: 원본 녹화는 안전하게 유지되며 잘라내기는 실행 취소하거나 복원할 수 있습니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không phá hủy: bản ghi gốc của bạn vẫn an toàn và các đoạn cắt có thể được hoàn tác hoặc khôi phục." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "非破坏性编辑：原始录制安全无损，剪除操作可以撤销或恢复。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Não destrutivo: sua gravação original fica segura, e os cortes podem ser desfeitos ou restaurados." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Não destrutivo: a gravação original permanece segura e os cortes podem ser anulados ou restaurados." } }
      }
    },
    "Dismiss transcript editing guidance": {
      "extractionState": "manual",

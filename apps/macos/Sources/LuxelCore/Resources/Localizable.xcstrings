        "pt-BR": { "stringUnit": { "state": "translated", "value": "Inicia automaticamente a reprodução ao selecionar uma palavra da transcrição." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Inicia automaticamente a reprodução ao selecionar uma palavra da transcrição." } }
      }
    },
    "transcription.error.authorizationDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allow Speech Recognition in System Settings, then retry." } },
        "de": { "stringUnit": { "state": "translated", "value": "Erlaube die Spracherkennung in den Systemeinstellungen und versuche es erneut." } },
        "es": { "stringUnit": { "state": "translated", "value": "Permite el reconocimiento de voz en Ajustes del Sistema y vuelve a intentarlo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Autorisez la reconnaissance vocale dans Réglages Système, puis réessayez." } },
        "it": { "stringUnit": { "state": "translated", "value": "Consenti il riconoscimento vocale in Impostazioni di Sistema, quindi riprova." } },
        "ja": { "stringUnit": { "state": "translated", "value": "システム設定で音声認識を許可してから、もう一度お試しください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 설정에서 음성 인식을 허용한 다음 다시 시도하세요." } },

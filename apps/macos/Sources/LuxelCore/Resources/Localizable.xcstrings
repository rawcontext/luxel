    "commandLine.pair.message": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%@ wants to control Luxel. Approve only if you started `luxel pair` in Terminal." } },
        "de": { "stringUnit": { "state": "translated", "value": "%@ möchte Luxel steuern. Erlauben Sie dies nur, wenn Sie `luxel pair` im Terminal gestartet haben." } },
        "es": { "stringUnit": { "state": "translated", "value": "%@ quiere controlar Luxel. Apruébalo solo si ejecutaste `luxel pair` en Terminal." } },

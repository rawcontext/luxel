    "permissions.systemAudio.grant.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Luxel on for system audio in Screen & System Audio Recording. If Luxel is not listed, click + and add the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Luxel für Systemaudio unter „Bildschirm- & Systemaudioaufnahme“. Wenn Luxel nicht aufgeführt ist, klicke auf + und füge die App hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Luxel para el audio del sistema en «Grabación de pantalla y audio del sistema». Si Luxel no aparece, haz clic en + y añade la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Luxel pour le son du système dans « Enregistrement de l’écran et de l’audio du système ». Si Luxel ne figure pas dans la liste, cliquez sur + et ajoutez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Luxel per l’audio di sistema in “Registrazione schermo e audio di sistema”. Se Luxel non compare, fai clic su + e aggiungi l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画面収録とシステムオーディオ録音」でLuxelのシステムオーディオを許可してください。Luxelが一覧にない場合は、+をクリックしてアプリを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 및 시스템 오디오 녹음에서 Luxel의 시스템 오디오를 켜세요. Luxel이 목록에 없으면 +를 클릭하여 앱을 추가하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Luxel cho âm thanh hệ thống trong Ghi màn hình & âm thanh hệ thống. Nếu không thấy Luxel, hãy nhấp + và thêm ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“屏幕与系统音频录制”中为 Luxel 启用系统音频。如果列表中没有 Luxel，请点按 + 并添加该应用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Luxel para áudio do sistema em “Gravação de Tela e Áudio do Sistema”. Se o Luxel não estiver na lista, clique em + e adicione o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Luxel para áudio do sistema em “Gravação do ecrã e áudio do sistema”. Se o Luxel não estiver na lista, clique em + e adicione a app."
          }
        }
      }
    },
    "permissions.systemAudio.off.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System sound uses macOS Screen & System Audio Recording. Microphone uses a separate permission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemaudio verwendet „Bildschirm- & Systemaudioaufnahme“ von macOS. Das Mikrofon benötigt eine separate Berechtigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido del sistema usa «Grabación de pantalla y audio del sistema» de macOS. El micrófono usa un permiso aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son du système utilise l’autorisation macOS « Enregistrement de l’écran et de l’audio du système ». Le microphone utilise une autorisation distincte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio di sistema usa “Registrazione schermo e audio di sistema” di macOS. Il microfono usa un permesso separato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムサウンドにはmacOSの「画面収録とシステムオーディオ録音」を使用します。マイクには別の権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 사운드는 macOS의 화면 및 시스템 오디오 녹음 권한을 사용합니다. 마이크에는 별도 권한이 필요합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh hệ thống dùng quyền Ghi màn hình & âm thanh hệ thống của macOS. Micrô dùng quyền riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统声音使用 macOS 的“屏幕与系统音频录制”权限。麦克风使用单独的权限。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som do sistema usa “Gravação de Tela e Áudio do Sistema” do macOS. O microfone usa uma permissão separada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O som do sistema usa “Gravação do ecrã e áudio do sistema” do macOS. O microfone usa uma permissão separada."
          }
        }
      }
    },
    "permissions.systemAudio.off.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System sound is off"
          }
        },
        "de": {

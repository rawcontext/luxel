          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 업데이트 확인이 꺼져 있어 Luxel이 업데이트 서버에 연결하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng tự động kiểm tra bản cập nhật đã tắt; Luxel sẽ không liên hệ với máy chủ cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新已关闭；Luxel 不会联系更新服务器。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As verificações automáticas de atualização estão desativadas; o Luxel não entrará em contato com o servidor de atualizações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A procura automática de atualizações está desativada; o Luxel não contactará o servidor de atualizações."
          }
        }
      }
    },
    "updates.networkPolicy.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel only touches the network to check for updates, and only if enabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel greift nur auf das Netzwerk zu, um nach Updates zu suchen, und nur wenn dies aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel solo accede a la red para buscar actualizaciones y únicamente si se ha activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel accède au réseau uniquement pour rechercher des mises à jour, et seulement si cette option est activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel accede alla rete solo per controllare gli aggiornamenti e soltanto se l’opzione è abilitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

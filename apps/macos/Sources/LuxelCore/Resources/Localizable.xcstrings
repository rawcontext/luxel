    "Reduce background noise and improve spoken audio during export.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce background noise and improve spoken audio during export."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundgeräusche reduzieren und Sprache beim Export verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el ruido de fondo y mejora la voz durante la exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez le bruit de fond et améliorez la voix lors de l’exportation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci il rumore di fondo e migliora il parlato durante l’esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し時に背景ノイズを減らし、音声を聞き取りやすくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 때 배경 소음을 줄이고 음성을 개선합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm tiếng ồn nền và cải thiện lời nói khi xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出时减少背景噪音并改善语音。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o ruído de fundo e melhore a fala durante a exportação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o ruído de fundo e melhore a fala durante a exportação."
          }
        }
      }
    },
    "Runs locally, is intended for speech, and is applied only during export. Music and sound effects may change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs locally, is intended for speech, and is applied only during export. Music and sound effects may change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird lokal ausgeführt, ist für Sprache vorgesehen und nur beim Export aktiv. Musik und Soundeffekte können sich verändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta localmente, está pensado para voz y solo se aplica al exportar. La música y los efectos de sonido pueden cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne localement, est conçu pour la voix et ne s’applique que lors de l’exportation. La musique et les effets sonores peuvent changer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona localmente, è pensato per il parlato e viene applicato solo durante l’esportazione. Musica ed effetti sonori potrebbero cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルで実行され、音声向けで、書き出し時にのみ適用されます。音楽や効果音が変化する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬에서 실행되며 음성용이고 내보낼 때만 적용됩니다. 음악과 음향 효과가 달라질 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy cục bộ, dành cho giọng nói và chỉ áp dụng khi xuất. Nhạc và hiệu ứng âm thanh có thể thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机运行，专为语音设计，并且仅在导出时应用。音乐和音效可能会发生变化。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É executado localmente, foi criado para fala e só é aplicado durante a exportação. Músicas e efeitos sonoros podem mudar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É executado localmente, foi concebido para fala e só é aplicado durante a exportação. A música e os efeitos sonoros podem mudar."
          }
        }
      }
    },

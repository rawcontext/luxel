    "transcription.error.assetsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Speech transcription could not finish preparing. Wait a moment, then retry." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Sprachtranskription konnte nicht fertig vorbereitet werden. Warte einen Moment und versuche es erneut." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo terminar de preparar la transcripción de voz. Espera un momento y vuelve a intentarlo." } },

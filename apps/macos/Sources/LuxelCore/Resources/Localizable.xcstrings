    "Transcription failed.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Transcription failed."}},"de":{"stringUnit":{"state":"translated","value":"Transkription fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"La transcripción falló."}},"fr":{"stringUnit":{"state":"translated","value":"La transcription a échoué."}},"it":{"stringUnit":{"state":"translated","value":"Trascrizione non riuscita."}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしに失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"받아쓰기에 실패했습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Chép lời không thành công."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转写失败。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na transcrição."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A transcrição falhou."}}}},
    "Transcription language, turn segmentation, and speaker identification.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Transcription language, turn segmentation, and speaker identification."}},"de":{"stringUnit":{"state":"translated","value":"Transkriptionssprache, Gesprächssegmentierung und Sprechererkennung."}},"es":{"stringUnit":{"state":"translated","value":"Idioma de transcripción, segmentación de turnos e identificación de hablantes."}},"fr":{"stringUnit":{"state":"translated","value":"Langue de transcription, segmentation des prises de parole et identification des locuteurs."}},"it":{"stringUnit":{"state":"translated","value":"Lingua di trascrizione, segmentazione dei turni e identificazione dei parlanti."}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしの言語、発話の区切り、話者の識別。"}},"ko":{"stringUnit":{"state":"translated","value":"받아쓰기 언어, 발화 구분 및 화자 식별입니다."}},"vi":{"stringUnit":{"state":"translated","value":"Ngôn ngữ chép lời, chia lượt nói và nhận diện người nói."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转写语言、话轮分段和说话人识别。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Idioma da transcrição, segmentação de falas e identificação de falantes."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Idioma da transcrição, segmentação de intervenções e identificação de oradores."}}}},
    "permissions.systemAudio.enable.instructions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn Luxel on for system audio in Screen & System Audio Recording. If Luxel is not listed, click + and add the app."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere Luxel für Systemaudio unter „Bildschirm- & Systemaudioaufnahme“. Wenn Luxel nicht aufgeführt ist, klicke auf + und füge die App hinzu."}},"es":{"stringUnit":{"state":"translated","value":"Activa Luxel para el audio del sistema en «Grabación de pantalla y audio del sistema». Si Luxel no aparece, haz clic en + y añade la app."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Luxel pour le son du système dans « Enregistrement de l’écran et de l’audio du système ». Si Luxel ne figure pas dans la liste, cliquez sur + et ajoutez l’app."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Luxel per l’audio di sistema in “Registrazione schermo e audio di sistema”. Se Luxel non compare, fai clic su + e aggiungi l’app."}},"ja":{"stringUnit":{"state":"translated","value":"「画面収録とシステムオーディオ録音」でLuxelのシステムオーディオを許可してください。Luxelが一覧にない場合は、+をクリックしてアプリを追加します。"}},"ko":{"stringUnit":{"state":"translated","value":"화면 및 시스템 오디오 녹음에서 Luxel의 시스템 오디오를 켜세요. Luxel이 목록에 없으면 +를 클릭하여 앱을 추가하세요."}},"vi":{"stringUnit":{"state":"translated","value":"Bật Luxel cho âm thanh hệ thống trong Ghi màn hình & âm thanh hệ thống. Nếu không thấy Luxel, hãy nhấp + và thêm ứng dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“屏幕与系统音频录制”中为 Luxel 启用系统音频。如果列表中没有 Luxel，请点按 + 并添加该应用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative o Luxel para áudio do sistema em “Gravação de Tela e Áudio do Sistema”. Se o Luxel não estiver na lista, clique em + e adicione o app."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ative o Luxel para áudio do sistema em “Gravação do ecrã e áudio do sistema”. Se o Luxel não estiver na lista, clique em + e adicione a app."}}}},
    "permissions.inputMonitoring.instructions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn Luxel on in Input Monitoring, then return and try again. If permission is already on but capture remains unavailable, relaunch Luxel."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere Luxel unter „Eingabeüberwachung“, kehre zurück und versuche es erneut. Falls die Berechtigung bereits aktiviert ist und die Erfassung weiterhin nicht verfügbar ist, starte Luxel neu."}},"es":{"stringUnit":{"state":"translated","value":"Activa Luxel en Monitorización de entrada, vuelve e inténtalo de nuevo. Si el permiso ya está activado pero la captura sigue sin estar disponible, reinicia Luxel."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Luxel dans « Surveillance de l’entrée », puis revenez et réessayez. Si l’autorisation est déjà activée mais que la capture reste indisponible, relancez Luxel."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Luxel in Monitoraggio input, poi torna e riprova. Se il permesso è già attivo ma l’acquisizione non è disponibile, riavvia Luxel."}},"ja":{"stringUnit":{"state":"translated","value":"「入力監視」でLuxelを有効にしてから、戻って再試行してください。権限がすでに有効でも収録できない場合は、Luxelを再起動してください。"}},"ko":{"stringUnit":{"state":"translated","value":"입력 모니터링에서 Luxel을 켠 다음 돌아와 다시 시도하세요. 권한이 이미 켜져 있는데도 캡처할 수 없으면 Luxel을 다시 실행하세요."}},"vi":{"stringUnit":{"state":"translated","value":"Bật Luxel trong Giám sát đầu vào, rồi quay lại và thử lại. Nếu quyền đã bật nhưng vẫn không ghi được, hãy khởi động lại Luxel."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“输入监控”中启用 Luxel，然后返回重试。如果已启用权限但仍无法捕获，请重新启动 Luxel。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative o Luxel em Monitoração de Entrada, volte e tente novamente. Se a permissão já estiver ativada, mas a captura continuar indisponível, reinicie o Luxel."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ative o Luxel em Monitorização de entrada, regresse e tente novamente. Se a permissão já estiver ativada, mas a captura continuar indisponível, volte a abrir o Luxel."}}}},
    "permissions.screen.instructions": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn Luxel on in Screen & System Audio Recording. If Luxel is not listed, click + and add the app."}},"de":{"stringUnit":{"state":"translated","value":"Aktiviere Luxel unter „Bildschirm- & Systemaudioaufnahme“. Wenn Luxel nicht aufgeführt ist, klicke auf + und füge die App hinzu."}},"es":{"stringUnit":{"state":"translated","value":"Activa Luxel en Grabación de pantalla y audio del sistema. Si no aparece en la lista, haz clic en + y añade la app."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Luxel dans « Enregistrement de l’écran et de l’audio système ». Si l’app n’est pas répertoriée, cliquez sur + et ajoutez-la."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Luxel in Registrazione schermo e audio di sistema. Se non è nell’elenco, fai clic su + e aggiungi l’app."}},"ja":{"stringUnit":{"state":"translated","value":"「画面収録とシステムオーディオ録音」でLuxelを有効にしてください。一覧にない場合は、＋をクリックして追加してください。"}},"ko":{"stringUnit":{"state":"translated","value":"화면 및 시스템 오디오 녹음에서 Luxel을 켜세요. 목록에 없으면 +를 클릭하여 앱을 추가하세요."}},"vi":{"stringUnit":{"state":"translated","value":"Bật Luxel trong Ghi màn hình và âm thanh hệ thống. Nếu không có trong danh sách, hãy nhấp + và thêm ứng dụng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在“屏幕与系统音频录制”中启用 Luxel。如果列表中没有，请点按 + 并添加该 App。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative o Luxel em Gravação de Tela e Áudio do Sistema. Se não estiver na lista, clique em + e adicione o app."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ative o Luxel em Gravação do ecrã e do áudio do sistema. Se não estiver na lista, clique em + e adicione a aplicação."}}}},
    "Turn off the camera overlay.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn off the camera overlay."}},"de":{"stringUnit":{"state":"translated","value":"Kamera-Overlay ausschalten."}},"es":{"stringUnit":{"state":"translated","value":"Desactivar la superposición de cámara."}},"fr":{"stringUnit":{"state":"translated","value":"Désactiver l’incrustation caméra."}},"it":{"stringUnit":{"state":"translated","value":"Disattiva la sovrapposizione fotocamera."}},"ja":{"stringUnit":{"state":"translated","value":"カメラオーバーレイをオフにします。"}},"ko":{"stringUnit":{"state":"translated","value":"카메라 오버레이를 끕니다."}},"vi":{"stringUnit":{"state":"translated","value":"Tắt lớp phủ camera."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭摄像头叠加画面。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desativar a sobreposição da câmera."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Desativar a sobreposição da câmara."}}}},

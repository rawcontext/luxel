    "cameraOverlay.shape.cutoutHelp": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove the camera background and show only the presenter."}},"de":{"stringUnit":{"state":"translated","value":"Entfernt den Kamerahintergrund und zeigt nur die präsentierende Person."}},"es":{"stringUnit":{"state":"translated","value":"Elimina el fondo de la cámara y muestra solo al presentador."}},"fr":{"stringUnit":{"state":"translated","value":"Supprime l’arrière-plan de la caméra et affiche uniquement la personne."}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi lo sfondo della fotocamera e mostra solo la persona."}},"ja":{"stringUnit":{"state":"translated","value":"カメラの背景を削除し、発表者だけを表示します。"}},"ko":{"stringUnit":{"state":"translated","value":"카메라 배경을 제거하고 발표자만 표시합니다."}},"vi":{"stringUnit":{"state":"translated","value":"Xóa nền camera và chỉ hiển thị người thuyết trình."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除摄像头背景，仅显示演示者。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Remova o fundo da câmera e mostre apenas o apresentador."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Remova o fundo da câmara e mostre apenas o apresentador."}}}},

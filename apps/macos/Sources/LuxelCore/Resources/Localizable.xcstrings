    "Luxel error: %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel error: %@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel-Fehler: %@"}},"es":{"stringUnit":{"state":"translated","value":"Error de Luxel: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Erreur Luxel : %@"}},"it":{"stringUnit":{"state":"translated","value":"Errore di Luxel: %@"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelのエラー：%@"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 오류: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Lỗi Luxel: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 错误：%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Erro do Luxel: %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Erro do Luxel: %@"}}}},
    "Luxel exporting, %@ complete": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel exporting, %@ complete"}},"de":{"stringUnit":{"state":"translated","value":"Luxel exportiert, %@ abgeschlossen"}},"es":{"stringUnit":{"state":"translated","value":"Luxel está exportando, %@ completado"}},"fr":{"stringUnit":{"state":"translated","value":"Luxel exporte, %@ terminé"}},"it":{"stringUnit":{"state":"translated","value":"Luxel sta esportando, %@ completato"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelで書き出し中、%@完了"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 내보내기 중, %@ 완료"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel đang xuất, hoàn tất %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 正在导出，已完成 %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Luxel exportando, %@ concluído"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Luxel a exportar, %@ concluído"}}}},
    "Luxel finishing recording": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel finishing recording"}},"de":{"stringUnit":{"state":"translated","value":"Luxel schließt die Aufnahme ab"}},"es":{"stringUnit":{"state":"translated","value":"Luxel está finalizando la grabación"}},"fr":{"stringUnit":{"state":"translated","value":"Luxel termine l’enregistrement"}},"it":{"stringUnit":{"state":"translated","value":"Luxel sta completando la registrazione"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelが収録を終了中"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 녹화 마무리 중"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel đang hoàn tất bản ghi"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 正在完成录制"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Luxel finalizando gravação"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Luxel a finalizar a gravação"}}}},
    "recovery.corrupt.message": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel found an interrupted recording that appears corrupt. A diagnostic was recorded so this failure can be investigated.\n\n%@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel hat eine unterbrochene Aufnahme gefunden, die beschädigt zu sein scheint. Eine Diagnose wurde gespeichert, damit dieser Fehler untersucht werden kann.\n\n%@"}},"es":{"stringUnit":{"state":"translated","value":"Luxel encontró una grabación interrumpida que parece estar dañada. Se guardó un diagnóstico para poder investigar el fallo.\n\n%@"}},"fr":{"stringUnit":{"state":"translated","value":"Luxel a trouvé un enregistrement interrompu qui semble endommagé. Un diagnostic a été enregistré afin de permettre l’analyse de cette défaillance.\n\n%@"}},"it":{"stringUnit":{"state":"translated","value":"Luxel ha trovato una registrazione interrotta che sembra danneggiata. È stata salvata una diagnostica per consentire l’analisi del problema.\n\n%@"}},"ja":{"stringUnit":{"state":"translated","value":"中断された収録が見つかりましたが、破損している可能性があります。問題を調査できるように診断情報を保存しました。\n\n%@"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 손상된 것으로 보이는 중단된 녹화를 발견했습니다. 이 문제를 조사할 수 있도록 진단 정보를 저장했습니다.\n\n%@"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel tìm thấy một bản ghi bị gián đoạn có vẻ đã hỏng. Thông tin chẩn đoán đã được lưu để có thể điều tra lỗi này.\n\n%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 发现了一段中断且可能已损坏的录制。已保存诊断信息，以便调查此问题。\n\n%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel encontrou uma gravação interrompida que parece estar corrompida. Um diagnóstico foi salvo para que essa falha possa ser investigada.\n\n%@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel encontrou uma gravação interrompida que parece estar danificada. Foi guardado um diagnóstico para que esta falha possa ser investigada.\n\n%@"}}}},
    "recovery.repairable.message": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel found an interrupted recording with a known corruption signature. The file was left in place so you can inspect it or try a repair workflow later.\n\n%@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel hat eine unterbrochene Aufnahme mit einem bekannten Beschädigungsmuster gefunden. Die Datei wurde an ihrem Speicherort belassen, damit du sie prüfen oder später eine Reparatur versuchen kannst.\n\n%@"}},"es":{"stringUnit":{"state":"translated","value":"Luxel encontró una grabación interrumpida con un patrón de daño conocido. El archivo se dejó en su ubicación para que puedas examinarlo o intentar repararlo más tarde.\n\n%@"}},"fr":{"stringUnit":{"state":"translated","value":"Luxel a trouvé un enregistrement interrompu présentant un type de corruption connu. Le fichier a été conservé à son emplacement pour que vous puissiez l’examiner ou tenter de le réparer ultérieurement.\n\n%@"}},"it":{"stringUnit":{"state":"translated","value":"Luxel ha trovato una registrazione interrotta con un tipo di danneggiamento noto. Il file è stato lasciato nella sua posizione per consentirti di esaminarlo o tentare una riparazione in seguito.\n\n%@"}},"ja":{"stringUnit":{"state":"translated","value":"中断された収録に既知の破損パターンが見つかりました。後で内容を確認したり修復を試したりできるよう、ファイルは元の場所に残しています。\n\n%@"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel이 알려진 손상 패턴이 있는 중단된 녹화를 발견했습니다. 나중에 파일을 확인하거나 복구를 시도할 수 있도록 원래 위치에 그대로 두었습니다.\n\n%@"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel tìm thấy một bản ghi bị gián đoạn có dấu hiệu hỏng đã biết. Tệp được giữ nguyên tại chỗ để bạn kiểm tra hoặc thử sửa chữa sau.\n\n%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 发现了一段中断的录制，其中包含已知的损坏特征。文件仍保留在原位置，您可以检查它或稍后尝试修复。\n\n%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel encontrou uma gravação interrompida com um padrão de corrupção conhecido. O arquivo foi mantido no local para que você possa examiná-lo ou tentar repará-lo depois.\n\n%@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel encontrou uma gravação interrompida com um padrão de danos conhecido. O ficheiro foi mantido no local para que o possa examinar ou tentar reparar mais tarde.\n\n%@"}}}},
    "Luxel no longer has permission to open %@. Choose the recordings folder again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel no longer has permission to open %@. Choose the recordings folder again."}},"de":{"stringUnit":{"state":"translated","value":"Luxel darf %@ nicht mehr öffnen. Wähle den Aufnahmeordner erneut aus."}},"es":{"stringUnit":{"state":"translated","value":"Luxel ya no tiene permiso para abrir %@. Vuelve a elegir la carpeta de grabaciones."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel n’a plus l’autorisation d’ouvrir %@. Choisissez à nouveau le dossier des enregistrements."}},"it":{"stringUnit":{"state":"translated","value":"Luxel non ha più il permesso di aprire %@. Scegli di nuovo la cartella delle registrazioni."}},"ja":{"stringUnit":{"state":"translated","value":"Luxelには%@を開く権限がありません。収録フォルダをもう一度選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel에 %@를 열 권한이 더 이상 없습니다. 녹화 폴더를 다시 선택하세요."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel không còn quyền mở %@. Hãy chọn lại thư mục bản ghi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 不再有权打开 %@。请重新选择录制文件夹。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel não tem mais permissão para abrir %@. Escolha a pasta de gravações novamente."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel já não tem permissão para abrir %@. Escolha novamente a pasta de gravações."}}}},
    "Luxel notch inactive": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel notch inactive"}},"de":{"stringUnit":{"state":"translated","value":"Luxel-Notch inaktiv"}},"es":{"stringUnit":{"state":"translated","value":"Muesca de Luxel inactiva"}},"fr":{"stringUnit":{"state":"translated","value":"Encoche Luxel inactive"}},"it":{"stringUnit":{"state":"translated","value":"Notch di Luxel non attivo"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelのノッチは無効です"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 노치 비활성"}},"vi":{"stringUnit":{"state":"translated","value":"Phần khuyết Luxel không hoạt động"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 刘海区域未启用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Recorte do Luxel inativo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Recorte do Luxel inativo"}}}},
    "Luxel preview at %@ of %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel preview at %@ of %@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel-Vorschau bei %@ von %@"}},"es":{"stringUnit":{"state":"translated","value":"Vista previa de Luxel en %@ de %@"}},"fr":{"stringUnit":{"state":"translated","value":"Aperçu Luxel à %@ sur %@"}},"it":{"stringUnit":{"state":"translated","value":"Anteprima Luxel a %@ di %@"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelのプレビュー：%@／%@"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 미리보기 %@ / %@"}},"vi":{"stringUnit":{"state":"translated","value":"Bản xem trước Luxel ở %@ trên %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 预览：%@／%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Prévia do Luxel em %@ de %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Pré-visualização do Luxel em %@ de %@"}}}},
    "Luxel ready": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel ready"}},"de":{"stringUnit":{"state":"translated","value":"Luxel bereit"}},"es":{"stringUnit":{"state":"translated","value":"Luxel está listo"}},"fr":{"stringUnit":{"state":"translated","value":"Luxel est prêt"}},"it":{"stringUnit":{"state":"translated","value":"Luxel è pronto"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelは準備完了です"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 준비됨"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel đã sẵn sàng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 已就绪"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Luxel pronto"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Luxel pronto"}}}},
    "Luxel recording paused at %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel recording paused at %@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel-Aufnahme bei %@ pausiert"}},"es":{"stringUnit":{"state":"translated","value":"Grabación de Luxel en pausa en %@"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement Luxel en pause à %@"}},"it":{"stringUnit":{"state":"translated","value":"Registrazione Luxel in pausa a %@"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelの録画を%@で一時停止しました"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 녹화가 %@에 일시 정지됨"}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi Luxel đã tạm dừng tại %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 录制已在 %@ 暂停"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gravação do Luxel pausada em %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Gravação do Luxel em pausa em %@"}}}},
    "Luxel recording starts in %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel recording starts in %@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel-Aufnahme beginnt in %@"}},"es":{"stringUnit":{"state":"translated","value":"La grabación de Luxel comienza en %@"}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement Luxel commence dans %@"}},"it":{"stringUnit":{"state":"translated","value":"La registrazione Luxel inizia tra %@"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelの録画は%@後に開始します"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 녹화가 %@ 후 시작됩니다"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel bắt đầu ghi sau %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 将在 %@ 后开始录制"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A gravação do Luxel começa em %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"A gravação do Luxel começa dentro de %@"}}}},
    "Luxel recording, elapsed %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel recording, elapsed %@"}},"de":{"stringUnit":{"state":"translated","value":"Luxel nimmt auf, vergangen: %@"}},"es":{"stringUnit":{"state":"translated","value":"Luxel está grabando, transcurrido: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Luxel enregistre, temps écoulé : %@"}},"it":{"stringUnit":{"state":"translated","value":"Luxel sta registrando, trascorso: %@"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelで収録中、経過時間%@"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 녹화 중, 경과 시간 %@"}},"vi":{"stringUnit":{"state":"translated","value":"Luxel đang ghi, đã qua %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 正在录制，已用时间 %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Luxel gravando, decorrido: %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Luxel a gravar, decorrido: %@"}}}},
    "Luxel replay buffer %@ ready": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel replay buffer %@ ready"}},"de":{"stringUnit":{"state":"translated","value":"Luxel-Wiedergabepuffer zu %@ bereit"}},"es":{"stringUnit":{"state":"translated","value":"Búfer de repetición de Luxel listo al %@"}},"fr":{"stringUnit":{"state":"translated","value":"Tampon de relecture Luxel prêt à %@"}},"it":{"stringUnit":{"state":"translated","value":"Buffer di replay di Luxel pronto al %@"}},"ja":{"stringUnit":{"state":"translated","value":"Luxelのリプレイバッファは%@準備完了です"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel 리플레이 버퍼 %@ 준비됨"}},"vi":{"stringUnit":{"state":"translated","value":"Bộ đệm phát lại Luxel đã sẵn sàng %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 回放缓冲区已就绪 %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Buffer de replay do Luxel %@ pronto"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Memória intermédia de repetição do Luxel %@ pronta"}}}},
    "permissions.inputMonitoring.disclosure": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel stores typed characters and shortcut identities locally with the recording. You can pause capture at any time and remove the data later."}},"de":{"stringUnit":{"state":"translated","value":"Luxel speichert eingegebene Zeichen und Tastenkombinationen lokal mit der Aufnahme. Du kannst die Erfassung jederzeit pausieren und die Daten später entfernen."}},"es":{"stringUnit":{"state":"translated","value":"Luxel guarda localmente los caracteres escritos y los atajos pulsados junto con la grabación. Puedes pausar la captura en cualquier momento y eliminar los datos después."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel stocke localement les caractères saisis et les raccourcis utilisés avec l’enregistrement. Vous pouvez suspendre la capture à tout moment et supprimer les données ultérieurement."}},"it":{"stringUnit":{"state":"translated","value":"Luxel salva localmente i caratteri digitati e le scorciatoie utilizzate insieme alla registrazione. Puoi mettere in pausa l’acquisizione in qualsiasi momento ed eliminare i dati in seguito."}},"ja":{"stringUnit":{"state":"translated","value":"Luxelは入力した文字とショートカットを収録とともにこのMacに保存します。キー入力の収録はいつでも一時停止でき、データは後から削除できます。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel은 입력한 문자와 단축키 정보를 녹화와 함께 기기에 저장합니다. 언제든지 캡처를 일시 정지하고 나중에 데이터를 삭제할 수 있습니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel lưu các ký tự đã gõ và phím tắt đã dùng ngay trên máy cùng với bản ghi. Bạn có thể tạm dừng ghi bất cứ lúc nào và xóa dữ liệu sau."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 会将输入的字符和使用的快捷键随录制保存在本机上。您可以随时暂停捕获，并在之后删除这些数据。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel armazena localmente os caracteres digitados e os atalhos usados junto com a gravação. Você pode pausar a captura a qualquer momento e remover os dados depois."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel guarda localmente os carateres digitados e os atalhos utilizados juntamente com a gravação. Pode colocar a captura em pausa a qualquer momento e remover os dados mais tarde."}}}},
    "replayBuffer.consent.message": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Luxel will continuously capture your display in the background so it can save recent moments on demand. Clips are saved only when you choose Clip Replay Buffer."}},"de":{"stringUnit":{"state":"translated","value":"Luxel zeichnet deinen Bildschirm kontinuierlich im Hintergrund auf, um die letzten Momente bei Bedarf speichern zu können. Clips werden nur gespeichert, wenn du „Wiedergabepuffer als Clip speichern“ auswählst."}},"es":{"stringUnit":{"state":"translated","value":"Luxel capturará continuamente tu pantalla en segundo plano para poder guardar los últimos momentos cuando lo solicites. Los clips solo se guardan cuando eliges Crear clip del búfer de repetición."}},"fr":{"stringUnit":{"state":"translated","value":"Luxel capturera votre écran en continu en arrière-plan pour enregistrer les derniers instants à votre demande. Les extraits ne sont enregistrés que lorsque vous choisissez de créer un extrait du tampon de relecture."}},"it":{"stringUnit":{"state":"translated","value":"Luxel acquisirà continuamente lo schermo in background per salvare i momenti recenti su richiesta. Le clip vengono salvate solo quando scegli di creare una clip dal buffer di replay."}},"ja":{"stringUnit":{"state":"translated","value":"Luxelはディスプレイをバックグラウンドで継続的に収録し、必要に応じて直前の映像を保存できるようにします。クリップが保存されるのは「リプレイバッファをクリップ」を選択したときだけです。"}},"ko":{"stringUnit":{"state":"translated","value":"Luxel은 필요할 때 최근 장면을 저장할 수 있도록 백그라운드에서 디스플레이를 계속 캡처합니다. 리플레이 버퍼 클립 저장을 선택할 때만 클립이 저장됩니다."}},"vi":{"stringUnit":{"state":"translated","value":"Luxel sẽ liên tục ghi màn hình trong nền để có thể lưu những khoảnh khắc gần nhất khi bạn yêu cầu. Đoạn ghi chỉ được lưu khi bạn chọn lưu đoạn từ bộ đệm phát lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Luxel 将在后台持续捕获显示器画面，以便按需保存最近的内容。只有选择保存回放缓冲区片段时，才会保存片段。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Luxel capturará sua tela continuamente em segundo plano para salvar os momentos recentes quando você solicitar. Os clipes só são salvos quando você escolhe criar um clipe do buffer de replay."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Luxel capturará continuamente o ecrã em segundo plano para guardar os momentos recentes quando o solicitar. Os clips só são guardados quando escolhe criar um clip da memória intermédia de repetição."}}}},
    "Main Display": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Main Display"}},"de":{"stringUnit":{"state":"translated","value":"Hauptbildschirm"}},"es":{"stringUnit":{"state":"translated","value":"Pantalla principal"}},"fr":{"stringUnit":{"state":"translated","value":"Écran principal"}},"it":{"stringUnit":{"state":"translated","value":"Schermo principale"}},"ja":{"stringUnit":{"state":"translated","value":"メインディスプレイ"}},"ko":{"stringUnit":{"state":"translated","value":"주 디스플레이"}},"vi":{"stringUnit":{"state":"translated","value":"Màn hình chính"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主显示器"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tela principal"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ecrã principal"}}}},
    "Matched in %d recordings": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Matched in %d recordings"}},"de":{"stringUnit":{"state":"translated","value":"In %d Aufnahmen erkannt"}},"es":{"stringUnit":{"state":"translated","value":"Identificado en %d grabaciones"}},"fr":{"stringUnit":{"state":"translated","value":"Identifié dans %d enregistrements"}},"it":{"stringUnit":{"state":"translated","value":"Identificato in %d registrazioni"}},"ja":{"stringUnit":{"state":"translated","value":"%d件の収録で一致"}},"ko":{"stringUnit":{"state":"translated","value":"녹화 %d개에서 일치"}},"vi":{"stringUnit":{"state":"translated","value":"Đã nhận diện trong %d bản ghi"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 %d 个录制中匹配"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Identificado em %d gravações"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Identificado em %d gravações"}}}},
    "Matched in 1 recording": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Matched in 1 recording"}},"de":{"stringUnit":{"state":"translated","value":"In 1 Aufnahme erkannt"}},"es":{"stringUnit":{"state":"translated","value":"Identificado en 1 grabación"}},"fr":{"stringUnit":{"state":"translated","value":"Identifié dans 1 enregistrement"}},"it":{"stringUnit":{"state":"translated","value":"Identificato in 1 registrazione"}},"ja":{"stringUnit":{"state":"translated","value":"1件の収録で一致"}},"ko":{"stringUnit":{"state":"translated","value":"녹화 1개에서 일치"}},"vi":{"stringUnit":{"state":"translated","value":"Đã nhận diện trong 1 bản ghi"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 1 个录制中匹配"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Identificado em 1 gravação"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Identificado em 1 gravação"}}}},

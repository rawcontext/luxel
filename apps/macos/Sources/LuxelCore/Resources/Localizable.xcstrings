            "state": "translated",
            "value": "Permite el acceso al micrófono para añadir tu voz a las grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès au microphone pour ajouter votre voix aux enregistrements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso al microfono per aggiungere la tua voce alle registrazioni."
          }
        },
        "ja": {

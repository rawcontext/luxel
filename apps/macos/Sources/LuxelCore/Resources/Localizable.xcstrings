    "Show a timestamp before each turn in copied Markdown transcripts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a timestamp before each turn in copied Markdown transcripts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jedem Redebeitrag in kopierten Markdown-Transkripten einen Zeitstempel anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una marca de tiempo antes de cada intervención en las transcripciones copiadas en Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un horodatage avant chaque prise de parole dans les transcriptions copiées en Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

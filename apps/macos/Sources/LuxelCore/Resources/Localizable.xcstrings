        "en": { "stringUnit": { "state": "translated", "value": "Movies, the recording folder, and folders you add are available to command line requests." } },
        "de": { "stringUnit": { "state": "translated", "value": "Filme, der Aufnahmeordner und hinzugefügte Ordner sind für Befehlszeilenanfragen verfügbar." } },
        "es": { "stringUnit": { "state": "translated", "value": "Películas, la carpeta de grabaciones y las carpetas que añadas estarán disponibles para la línea de comandos." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Films, le dossier d’enregistrement et les dossiers ajoutés sont accessibles aux commandes." } },
        "it": { "stringUnit": { "state": "translated", "value": "Filmati, la cartella delle registrazioni e le cartelle aggiunte sono disponibili ai comandi." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ムービー、録画フォルダ、追加したフォルダをコマンドライン要求で使用できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "동영상, 녹화 폴더 및 추가한 폴더를 명령줄 요청에서 사용할 수 있습니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Phim, thư mục bản ghi và các thư mục bạn thêm sẽ khả dụng cho yêu cầu dòng lệnh." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "“影片”、录制文件夹和你添加的文件夹可供命令行请求使用。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Filmes, a pasta de gravações e as pastas adicionadas ficam disponíveis para comandos." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Filmes, a pasta de gravações e as pastas adicionadas ficam disponíveis para comandos." } }
      }
    },

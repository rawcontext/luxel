          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel은 활성화된 경우에만 업데이트 확인을 위해 네트워크를 사용합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel chỉ truy cập mạng để kiểm tra bản cập nhật và chỉ khi tính năng này được bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel 仅在启用后通过网络检查更新。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Luxel só acessa a rede para verificar atualizações e apenas quando essa opção está ativada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Luxel só acede à rede para procurar atualizações e apenas quando essa opção está ativada."
          }
        }
      }
    },

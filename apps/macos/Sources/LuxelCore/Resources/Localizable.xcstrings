        "ko": { "stringUnit": { "state": "translated", "value": "Luxel이 이 녹화에서 트랜스크립션할 오디오 트랙을 찾지 못했습니다." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Luxel không tìm thấy rãnh âm thanh để chép lời trong bản ghi này." } },

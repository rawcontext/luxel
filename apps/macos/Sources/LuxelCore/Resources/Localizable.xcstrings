          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownとしてコピーした文字起こしの各発話の前にタイムスタンプを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown으로 복사한 대화록의 각 발화 앞에 타임스탬프를 표시합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị dấu thời gian trước mỗi lượt nói trong bản chép lời được sao chép dưới dạng Markdown."

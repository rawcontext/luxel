    "transcription.error.assetsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Speech transcription could not finish preparing. Wait a moment, then retry." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Sprachtranskription konnte nicht fertig vorbereitet werden. Warte einen Moment und versuche es erneut." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo terminar de preparar la transcripción de voz. Espera un momento y vuelve a intentarlo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La préparation de la transcription vocale n’a pas pu se terminer. Patientez un instant, puis réessayez." } },
        "it": { "stringUnit": { "state": "translated", "value": "Non è stato possibile completare la preparazione della trascrizione vocale. Attendi un momento, quindi riprova." } },
        "ja": { "stringUnit": { "state": "translated", "value": "音声文字起こしの準備を完了できませんでした。しばらく待ってから、もう一度お試しください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "음성 트랜스크립션 준비를 완료하지 못했습니다. 잠시 기다린 다음 다시 시도하세요." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Không thể hoàn tất việc chuẩn bị chép lời giọng nói. Hãy đợi một lát rồi thử lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "语音转录未能完成准备。请稍等片刻，然后重试。" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Não foi possível concluir a preparação da transcrição de voz. Aguarde um momento e tente novamente." } },
        "pt-PT": { "stringUnit": { "state": "translated", "value": "Não foi possível concluir a preparação da transcrição de voz. Aguarde um momento e tente novamente." } }
      }
    },
    "transcription.error.missingAudioTrack": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Luxel could not find an audio track to transcribe in this recording." } },
        "de": { "stringUnit": { "state": "translated", "value": "Luxel konnte in dieser Aufnahme keine Audiospur zum Transkribieren finden." } },
        "es": { "stringUnit": { "state": "translated", "value": "Luxel no pudo encontrar una pista de audio para transcribir en esta grabación." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Luxel n’a trouvé aucune piste audio à transcrire dans cet enregistrement." } },

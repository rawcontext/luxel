    "updates.networkPolicy.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic update checks are off; Luxel will not contact the update server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Updateprüfungen sind deaktiviert; Luxel kontaktiert den Updateserver nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las comprobaciones automáticas de actualizaciones están desactivadas; Luxel no contactará con el servidor de actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche automatique de mises à jour est désactivée ; Luxel ne contactera pas le serveur de mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo automatico degli aggiornamenti è disattivato; Luxel non contatterà il server degli aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートの自動確認はオフです。Luxelはアップデートサーバに接続しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 업데이트 확인이 꺼져 있어 Luxel이 업데이트 서버에 연결하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng tự động kiểm tra bản cập nhật đã tắt; Luxel sẽ không liên hệ với máy chủ cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新已关闭；Luxel 不会联系更新服务器。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As verificações automáticas de atualização estão desativadas; o Luxel não entrará em contato com o servidor de atualizações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A procura automática de atualizações está desativada; o Luxel não contactará o servidor de atualizações."
          }
        }
      }
    },
    "updates.networkPolicy.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel only touches the network to check for updates, and only if enabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel greift nur auf das Netzwerk zu, um nach Updates zu suchen, und nur wenn dies aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel solo accede a la red para buscar actualizaciones y únicamente si se ha activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

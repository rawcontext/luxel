    "permissions.screen.off.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS needs approval before Luxel can record your screen or system sound. If Luxel is not listed, click + and add the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS benötigt deine Zustimmung, bevor Luxel Bildschirm oder Systemaudio aufnehmen kann. Wenn Luxel nicht aufgeführt ist, klicke auf + und füge die App hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS necesita tu autorización para que Luxel pueda grabar la pantalla o el sonido del sistema. Si Luxel no aparece, haz clic en + y añade la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS requiert votre autorisation avant que Luxel puisse enregistrer l’écran ou le son du système. Si Luxel ne figure pas dans la liste, cliquez sur + et ajoutez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS richiede la tua autorizzazione prima che Luxel possa registrare lo schermo o l’audio di sistema. Se Luxel non compare, fai clic su + e aggiungi l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxelが画面またはシステムサウンドを録画するには、macOSでの許可が必要です。Luxelが一覧にない場合は、+をクリックしてアプリを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel이 화면이나 시스템 사운드를 녹음하려면 macOS의 승인이 필요합니다. Luxel이 목록에 없으면 +를 클릭하여 앱을 추가하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS cần bạn cho phép trước khi Luxel có thể ghi màn hình hoặc âm thanh hệ thống. Nếu không thấy Luxel, hãy nhấp + và thêm ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxel 录制屏幕或系统声音前需要获得 macOS 的批准。如果列表中没有 Luxel，请点按 + 并添加该应用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS precisa de aprovação para que o Luxel possa gravar a tela ou o som do sistema. Se o Luxel não estiver na lista, clique em + e adicione o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS precisa de autorização antes de o Luxel poder gravar o ecrã ou o som do sistema. Se o Luxel não estiver na lista, clique em + e adicione a app."
          }
        }
      }
    },

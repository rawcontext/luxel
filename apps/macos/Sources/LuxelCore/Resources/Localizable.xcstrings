    "Recordings are saved in monthly folders, with a folder for each recording.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Recordings are saved in monthly folders, with a folder for each recording."}},"de":{"stringUnit":{"state":"translated","value":"Aufnahmen werden in Monatsordnern gespeichert, mit einem Ordner pro Aufnahme."}},"es":{"stringUnit":{"state":"translated","value":"Las grabaciones se guardan en carpetas mensuales, con una carpeta para cada grabación."}},"fr":{"stringUnit":{"state":"translated","value":"Les enregistrements sont classés par mois, avec un dossier par enregistrement."}},"it":{"stringUnit":{"state":"translated","value":"Le registrazioni vengono salvate in cartelle mensili, con una cartella per registrazione."}},"ja":{"stringUnit":{"state":"translated","value":"収録は月別フォルダに保存され、各収録に専用のフォルダが作成されます。"}},"ko":{"stringUnit":{"state":"translated","value":"녹화는 월별 폴더에 저장되며 각 녹화마다 폴더가 만들어집니다."}},"vi":{"stringUnit":{"state":"translated","value":"Bản ghi được lưu trong thư mục theo tháng, mỗi bản ghi có một thư mục riêng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录制按月保存，每个录制有独立文件夹。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As gravações são salvas em pastas mensais, com uma pasta para cada gravação."}},"pt-PT":{"stringUnit":{"state":"translated","value":"As gravações são guardadas em pastas mensais, com uma pasta por gravação."}}}},

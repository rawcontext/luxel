        "de": { "stringUnit": { "state": "translated", "value": "Entfernte Transkriptbereiche prüfen und wiederherstellen" } },
        "es": { "stringUnit": { "state": "translated", "value": "Revisar y restaurar intervalos eliminados de la transcripción" } },

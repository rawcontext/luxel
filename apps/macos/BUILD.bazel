    deps = [":LuxelApp"],
)

app_metadata(
    name = "app_info",
    src = "Configuration/Luxel/Info.plist",
    app_store = ":app_store",
)

MODEL_NAMES = [
    "speaker-diarization",
    "studio-voice",
    "modnet",
    "voice-activity-detection",
]

[
    copy_to_directory(
        name = "model_" + model,
        srcs = glob(
            ["Vendor/Models/" + model + "/**"],
            exclude = ["**/.DS_Store"],
        ),
        out = "model-inputs/" + model,
        root_paths = ["apps/macos/Vendor/Models/" + model],
    )
    for model in MODEL_NAMES
]

py_binary(
    name = "model_auditor",
    srcs = ["Scripts/audit-bundled-model.py"],
    main = "Scripts/audit-bundled-model.py",
)

[
    run_binary(
        name = "check_" + model,
        srcs = [
            ":model_" + model,
            "Scripts/audit-bundled-model.py",
        ],
        args = [
            "$(location Scripts/audit-bundled-model.py)",
            model,
            "$(location :model_" + model + ")",
        ],
        stdout = "checks/" + model + ".txt",
        tool = "//tools/bazel:validate_model",
    )
    for model in MODEL_NAMES
]

copy_to_directory(
    name = "app_models",
    srcs = [":model_" + model for model in MODEL_NAMES],
    out = "Models",
    root_paths = ["apps/macos/model-inputs"],
)

copy_to_directory(
    name = "codec_audit_snapshot",
    srcs = glob(
        [
            "Vendor/Artifacts/**",
            "Vendor/*.sh",
            "Scripts/*.py",
            "Scripts/build-luxel*.sh",
        ],
        exclude = ["**/.DS_Store"],
    ) + [
        "THIRD_PARTY_LICENSES.md",
        "//:.tool-versions",
    ],
    hardlink = "off",
    root_paths = [],
)

run_binary(
    name = "codec_artifact_check",
    srcs = [":codec_audit_snapshot"],
    args = [
        "$(location :codec_audit_snapshot)/apps/macos/Scripts/audit-native-codecs.py",
        "--self-test",
    ],
    stdout = "checks/native-codecs.txt",
    tool = "//tools/bazel:run_python_script",
)

validated_files(
    name = "validated_models",
    srcs = [":app_models"],
    checks = [":check_" + model for model in MODEL_NAMES] + [":codec_artifact_check"],
)

copy_file(
    name = "license_resource",
    src = "//:LICENSE",
    out = "resources/LICENSE.txt",
)

copy_file(
    name = "notices_resource",
    src = "THIRD_PARTY_LICENSES.md",
    out = "resources/ThirdPartyLicenses.md",
)

macos_application(
    name = "app",
    additional_contents = {":validated_models": "Resources/Models"},
    app_icons = glob(["Configuration/Luxel/Luxel.icon/**"]),
    bundle_id = select({
        ":mac_app_store": "com.rawcontext.luxel",
        "//conditions:default": "com.rawcontext.luxel.dev",
    }),
    bundle_name = "Luxel",
    executable_name = "Luxel",
    features = ["disable_legacy_signing"],
    infoplists = [":app_info"],
    minimum_os_version = "26.0",
    resources = [
        "Configuration/Luxel/PrivacyInfo.xcprivacy",
        ":license_resource",
        ":notices_resource",
    ],
    strings = glob(["Configuration/Luxel/Localizations/**/*.strings"]),
    deps = [":LuxelLauncher"],
)

output_files(
    name = "app_archive",
    paths = ["apps/macos/app.zip"],
    target = ":app",
)

py_test(
    name = "app_bundle_test",
    size = "small",
    srcs = ["//tools/bazel:verify_app_bundle.py"],
    args = [
        "$(rlocationpath :app_archive)",
        "$(rlocationpath Configuration/Luxel/Info.plist)",
        "$(rlocationpath Configuration/Luxel/PrivacyInfo.xcprivacy)",
        "$(rlocationpath THIRD_PARTY_LICENSES.md)",
        "$(rlocationpath //:LICENSE)",
        "$(rlocationpath Sources/LuxelCore/Resources/Localizable.xcstrings)",
        "$(rlocationpath Scripts/audit-bundled-model.py)",
    ] + select({
        ":mac_app_store": [
            "com.rawcontext.luxel",
            "Luxel",
            "luxel",
        ],
        "//conditions:default": [
            "com.rawcontext.luxel.dev",
            "'Luxel Dev'",
            "luxel-dev",
        ],
    }),
    data = [
        "Configuration/Luxel/Info.plist",
        "Configuration/Luxel/PrivacyInfo.xcprivacy",
        "Scripts/audit-bundled-model.py",
        "Sources/LuxelCore/Resources/Localizable.xcstrings",
        "THIRD_PARTY_LICENSES.md",
        ":app_archive",
        "//:LICENSE",
    ],
    main = "verify_app_bundle.py",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_python//python/runfiles"],
)


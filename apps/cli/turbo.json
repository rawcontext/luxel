{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["target/universal-apple-darwin/release/luxel"],
      "env": ["ASDF_RUST_VERSION", "RUSTFLAGS", "MACOSX_DEPLOYMENT_TARGET", "DEVELOPER_DIR", "SDKROOT"]
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}

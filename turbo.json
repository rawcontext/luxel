{
  "$schema": "https://v2-10-11.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".build/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "app:build": {
      "cache": false
    },
    "app:build:mas": {
      "cache": false
    },
    "check:codec-licenses": {
      "cache": false
    },
    "check:distribution": {
      "cache": false
    }
  }
}
